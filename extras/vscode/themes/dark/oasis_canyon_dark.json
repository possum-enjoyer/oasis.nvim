  "name": "Oasis Canyon Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#F4E36B"
    },
    "class": {
      "foreground": "#81C0B6"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#9F7051"
    },
    "decorator": {
      "foreground": "#FFA852"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#9F7051"
    },
    "enum": {
      "foreground": "#81C0B6"
    },
    "enumMember": {
      "foreground": "#F4E36B"
    },
    "function": {
      "foreground": "#FFDCA4"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFDCA4"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#636363"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#81C0B6"
    },
    "keyword": {
      "foreground": "#FFB870"
    },
    "label": {
      "foreground": "#FFB870"
    },
    "macro": {
      "foreground": "#87CEEB"
    },
    "method": {
      "foreground": "#FFDCA4"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFDCA4"
    },
    "namespace": {
      "foreground": "#81C0B6"
    },
    "number": {
      "foreground": "#F4E36B"
    },
    "operator": {
      "foreground": "#FFA0A0"
    },
    "parameter": {
      "foreground": "#F8E7D3"
    },
    "property": {
      "foreground": "#96D4CB"
    },
    "property.declaration": {
      "foreground": "#F8E7D3"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#FFB870"
    },
    "string": {
      "foreground": "#34CB7D"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#A6EE93"
    },
    "string.regexp": {
      "foreground": "#A6EE93"
    },
    "struct": {
      "foreground": "#81C0B6"
    },
    "type": {
      "foreground": "#81C0B6"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#81C0B6"
    },
    "variable": {
      "foreground": "#F8E7D3"
    },
    "variable.defaultLibrary": {
      "foreground": "#76C4FD"
    },
    "variable.readonly": {
      "foreground": "#F4E36B"
    },
    "variable.readonly.local": {
      "foreground": "#F8E7D3"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9F7051"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#34CB7D"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A6EE93"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#A6EE93"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFDCA4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#F4E36B"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#F8E7D3"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#76C4FD"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFDCA4"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA852"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#F09595"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#96D4CB"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#F4E36B"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    }
  ],
  "type": "dark"
}