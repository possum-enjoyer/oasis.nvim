  "name": "Oasis Cactus Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#FFA247"
    },
    "class": {
      "foreground": "#58B8FD"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#608864"
    },
    "decorator": {
      "foreground": "#FFA852"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#608864"
    },
    "enum": {
      "foreground": "#58B8FD"
    },
    "enumMember": {
      "foreground": "#FFA247"
    },
    "function": {
      "foreground": "#FFB870"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#756456"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#58B8FD"
    },
    "keyword": {
      "foreground": "#AED6B0"
    },
    "label": {
      "foreground": "#AED6B0"
    },
    "macro": {
      "foreground": "#FFDCA4"
    },
    "method": {
      "foreground": "#FFB870"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "namespace": {
      "foreground": "#58B8FD"
    },
    "number": {
      "foreground": "#FFA247"
    },
    "operator": {
      "foreground": "#FFB0B0"
    },
    "parameter": {
      "foreground": "#DDF0E5"
    },
    "property": {
      "foreground": "#87CEEB"
    },
    "property.declaration": {
      "foreground": "#DDF0E5"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#AED6B0"
    },
    "string": {
      "foreground": "#34CB7D"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#96EA7F"
    },
    "string.regexp": {
      "foreground": "#96EA7F"
    },
    "struct": {
      "foreground": "#58B8FD"
    },
    "type": {
      "foreground": "#58B8FD"
    },
    "type.declaration": {
      "foreground": "#58B8FD"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#58B8FD"
    },
    "variable": {
      "foreground": "#DDF0E5"
    },
    "variable.defaultLibrary": {
      "foreground": "#F0E68C"
    },
    "variable.readonly": {
      "foreground": "#FFA247"
    },
    "variable.readonly.local": {
      "foreground": "#DDF0E5"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#608864"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#AED6B0"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#34CB7D"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#DDF0E5"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#F0E68C"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7FBB82"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#93C795"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#FBABAB"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#756456"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#87CEEB"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#AED6B0"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#756456"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    }
  ],
  "type": "dark"
}