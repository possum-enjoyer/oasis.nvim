  "name": "Oasis Rose Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#FFA247"
    },
    "class": {
      "foreground": "#5ABAAE"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#9F6C85"
    },
    "decorator": {
      "foreground": "#FFA852"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#9F6C85"
    },
    "enum": {
      "foreground": "#5ABAAE"
    },
    "enumMember": {
      "foreground": "#FFA247"
    },
    "function": {
      "foreground": "#FFB870"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#706156"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#5ABAAE"
    },
    "keyword": {
      "foreground": "#FFA0A0"
    },
    "label": {
      "foreground": "#FFA0A0"
    },
    "macro": {
      "foreground": "#87CEEB"
    },
    "method": {
      "foreground": "#FFB870"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "namespace": {
      "foreground": "#5ABAAE"
    },
    "number": {
      "foreground": "#FFA247"
    },
    "operator": {
      "foreground": "#FABDA2"
    },
    "parameter": {
      "foreground": "#EDD5E7"
    },
    "property": {
      "foreground": "#8FD1C7"
    },
    "property.declaration": {
      "foreground": "#EDD5E7"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#FFA0A0"
    },
    "string": {
      "foreground": "#34CB7D"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#96EA7F"
    },
    "string.regexp": {
      "foreground": "#96EA7F"
    },
    "struct": {
      "foreground": "#5ABAAE"
    },
    "type": {
      "foreground": "#5ABAAE"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#5ABAAE"
    },
    "variable": {
      "foreground": "#EDD5E7"
    },
    "variable.defaultLibrary": {
      "foreground": "#58B8FD"
    },
    "variable.readonly": {
      "foreground": "#FFA247"
    },
    "variable.readonly.local": {
      "foreground": "#EDD5E7"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9F6C85"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFA0A0"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#34CB7D"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#5ABAAE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#EDD5E7"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#5ABAAE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FFA0A0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FF8080"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#FBABAB"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#706156"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8FD1C7"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FFA0A0"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#706156"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#5ABAAE"
      }
    }
  ],
  "type": "dark"
}