  "name": "Oasis Lagoon Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#FFA247"
    },
    "class": {
      "foreground": "#81C0B6"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#467B99"
    },
    "decorator": {
      "foreground": "#FFA852"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#467B99"
    },
    "enum": {
      "foreground": "#81C0B6"
    },
    "enumMember": {
      "foreground": "#FFA247"
    },
    "function": {
      "foreground": "#FFC78F"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFC78F"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#665D55"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#81C0B6"
    },
    "keyword": {
      "foreground": "#58B8FD"
    },
    "label": {
      "foreground": "#58B8FD"
    },
    "macro": {
      "foreground": "#87CEEB"
    },
    "method": {
      "foreground": "#FFC78F"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFC78F"
    },
    "namespace": {
      "foreground": "#81C0B6"
    },
    "number": {
      "foreground": "#FFA247"
    },
    "operator": {
      "foreground": "#FFA0A0"
    },
    "parameter": {
      "foreground": "#D9E6FA"
    },
    "property": {
      "foreground": "#A8DDD5"
    },
    "property.declaration": {
      "foreground": "#D9E6FA"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#58B8FD"
    },
    "string": {
      "foreground": "#53D390"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#96EA7F"
    },
    "string.regexp": {
      "foreground": "#96EA7F"
    },
    "struct": {
      "foreground": "#81C0B6"
    },
    "type": {
      "foreground": "#81C0B6"
    },
    "type.declaration": {
      "foreground": "#81C0B6"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#81C0B6"
    },
    "variable": {
      "foreground": "#D9E6FA"
    },
    "variable.defaultLibrary": {
      "foreground": "#F0E68C"
    },
    "variable.readonly": {
      "foreground": "#FFA247"
    },
    "variable.readonly.local": {
      "foreground": "#D9E6FA"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#467B99"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#53D390"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFC78F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#D9E6FA"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#F0E68C"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFC78F"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1CA0FD"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3AACFD"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#F09595"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A8DDD5"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#665D55"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    }
  ],
  "type": "dark"
}