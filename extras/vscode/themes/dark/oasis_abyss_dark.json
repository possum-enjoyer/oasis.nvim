  "name": "Oasis Abyss Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#FFA247"
    },
    "class": {
      "foreground": "#5ABAAE"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#546D79"
    },
    "decorator": {
      "foreground": "#FFA247"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#546D79"
    },
    "enum": {
      "foreground": "#5ABAAE"
    },
    "enumMember": {
      "foreground": "#FFA247"
    },
    "function": {
      "foreground": "#FFB870"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#5E5148"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#5ABAAE"
    },
    "keyword": {
      "foreground": "#F58888"
    },
    "label": {
      "foreground": "#F58888"
    },
    "macro": {
      "foreground": "#6BBAE0"
    },
    "method": {
      "foreground": "#FFB870"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "namespace": {
      "foreground": "#5ABAAE"
    },
    "number": {
      "foreground": "#FFA247"
    },
    "operator": {
      "foreground": "#F9AD92"
    },
    "parameter": {
      "foreground": "#F0EBE6"
    },
    "property": {
      "foreground": "#81C0B6"
    },
    "property.declaration": {
      "foreground": "#F0EBE6"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#F58888"
    },
    "string": {
      "foreground": "#53D390"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#96EA7F"
    },
    "string.regexp": {
      "foreground": "#96EA7F"
    },
    "struct": {
      "foreground": "#5ABAAE"
    },
    "type": {
      "foreground": "#5ABAAE"
    },
    "type.declaration": {
      "foreground": "#5ABAAE"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#5ABAAE"
    },
    "variable": {
      "foreground": "#F0EBE6"
    },
    "variable.defaultLibrary": {
      "foreground": "#58B8FD"
    },
    "variable.readonly": {
      "foreground": "#FFA247"
    },
    "variable.readonly.local": {
      "foreground": "#F0EBE6"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#546D79"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F58888"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#53D390"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#5ABAAE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#F0EBE6"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#5ABAAE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D06666"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#E87272"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#E58383"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F58888"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#5E5148"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#5ABAAE"
      }
    }
  ],
  "type": "dark"
}