  "name": "Oasis Twilight Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#FFA852"
    },
    "class": {
      "foreground": "#81C0B6"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#8073A1"
    },
    "decorator": {
      "foreground": "#FFA852"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#8073A1"
    },
    "enum": {
      "foreground": "#81C0B6"
    },
    "enumMember": {
      "foreground": "#FFA852"
    },
    "function": {
      "foreground": "#FFC78F"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFC78F"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#6F6055"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#81C0B6"
    },
    "keyword": {
      "foreground": "#DEC2FF"
    },
    "label": {
      "foreground": "#DEC2FF"
    },
    "macro": {
      "foreground": "#87CEEB"
    },
    "method": {
      "foreground": "#FFC78F"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFC78F"
    },
    "namespace": {
      "foreground": "#81C0B6"
    },
    "number": {
      "foreground": "#FFA852"
    },
    "operator": {
      "foreground": "#FFB0B0"
    },
    "parameter": {
      "foreground": "#E6E0F8"
    },
    "property": {
      "foreground": "#A8DDD5"
    },
    "property.declaration": {
      "foreground": "#E6E0F8"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#DEC2FF"
    },
    "string": {
      "foreground": "#34CB7D"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#96EA7F"
    },
    "string.regexp": {
      "foreground": "#96EA7F"
    },
    "struct": {
      "foreground": "#81C0B6"
    },
    "type": {
      "foreground": "#81C0B6"
    },
    "type.declaration": {
      "foreground": "#81C0B6"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#81C0B6"
    },
    "variable": {
      "foreground": "#E6E0F8"
    },
    "variable.defaultLibrary": {
      "foreground": "#58B8FD"
    },
    "variable.readonly": {
      "foreground": "#FFA852"
    },
    "variable.readonly.local": {
      "foreground": "#E6E0F8"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8073A1"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#DEC2FF"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#34CB7D"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#96EA7F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFC78F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#E6E0F8"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFC78F"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C28EFF"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#C695FF"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#F09595"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A8DDD5"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#DEC2FF"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#6F6055"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#81C0B6"
      }
    }
  ],
  "type": "dark"
}