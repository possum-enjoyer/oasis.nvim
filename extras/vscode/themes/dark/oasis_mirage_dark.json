  "name": "Oasis Mirage Dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#FFA247"
    },
    "class": {
      "foreground": "#58B8FD"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#387F74"
    },
    "decorator": {
      "foreground": "#FFA852"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#387F74"
    },
    "enum": {
      "foreground": "#58B8FD"
    },
    "enumMember": {
      "foreground": "#FFA247"
    },
    "function": {
      "foreground": "#FFB870"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#736458"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#58B8FD"
    },
    "keyword": {
      "foreground": "#96D4CB"
    },
    "label": {
      "foreground": "#96D4CB"
    },
    "macro": {
      "foreground": "#FFD393"
    },
    "method": {
      "foreground": "#FFB870"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#FFB870"
    },
    "namespace": {
      "foreground": "#58B8FD"
    },
    "number": {
      "foreground": "#FFA247"
    },
    "operator": {
      "foreground": "#FFB0B0"
    },
    "parameter": {
      "foreground": "#DDEFEF"
    },
    "property": {
      "foreground": "#94D0FE"
    },
    "property.declaration": {
      "foreground": "#DDEFEF"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#96D4CB"
    },
    "string": {
      "foreground": "#34CB7D"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#94E97C"
    },
    "string.regexp": {
      "foreground": "#94E97C"
    },
    "struct": {
      "foreground": "#58B8FD"
    },
    "type": {
      "foreground": "#58B8FD"
    },
    "type.declaration": {
      "foreground": "#58B8FD"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#58B8FD"
    },
    "variable": {
      "foreground": "#DDEFEF"
    },
    "variable.defaultLibrary": {
      "foreground": "#F0E68C"
    },
    "variable.readonly": {
      "foreground": "#FFA247"
    },
    "variable.readonly.local": {
      "foreground": "#DDEFEF"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#387F74"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#96D4CB"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#34CB7D"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#94E97C"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#94E97C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#DDEFEF"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#F0E68C"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA852"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFB870"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5ABAAE"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#5ABAAE"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#FBABAB"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#94D0FE"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#96D4CB"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#736458"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#FFA247"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#58B8FD"
      }
    }
  ],
  "type": "dark"
}