  "name": "Oasis Dune Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#464644"
    },
    "class": {
      "foreground": "#3a625c"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#7b6f64"
    },
    "decorator": {
      "foreground": "#954d10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#7b6f64"
    },
    "enum": {
      "foreground": "#3a625c"
    },
    "enumMember": {
      "foreground": "#464644"
    },
    "function": {
      "foreground": "#8c4a0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8c4a0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8f8f8f"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#3a625c"
    },
    "keyword": {
      "foreground": "#6b611a"
    },
    "label": {
      "foreground": "#6b611a"
    },
    "macro": {
      "foreground": "#236783"
    },
    "method": {
      "foreground": "#8c4a0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8c4a0f"
    },
    "namespace": {
      "foreground": "#3a625c"
    },
    "number": {
      "foreground": "#464644"
    },
    "operator": {
      "foreground": "#bf151c"
    },
    "parameter": {
      "foreground": "#57544b"
    },
    "property": {
      "foreground": "#366962"
    },
    "property.declaration": {
      "foreground": "#57544b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#6b611a"
    },
    "string": {
      "foreground": "#286646"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#316d20"
    },
    "string.regexp": {
      "foreground": "#316d20"
    },
    "struct": {
      "foreground": "#3a625c"
    },
    "type": {
      "foreground": "#3a625c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#3a625c"
    },
    "variable": {
      "foreground": "#57544b"
    },
    "variable.defaultLibrary": {
      "foreground": "#5f6062"
    },
    "variable.readonly": {
      "foreground": "#464644"
    },
    "variable.readonly.local": {
      "foreground": "#57544b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7b6f64"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6b611a"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286646"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#316d20"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#316d20"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3a625c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#464644"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#57544b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5f6062"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3a625c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#954d10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6c6733"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#615c33"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#bc1e23"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8f8f8f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#366962"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6b611a"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8f8f8f"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#464644"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#3a625c"
      }
    }
  ],
  "type": "light"
}