  "name": "Oasis Lagoon Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#424241"
    },
    "class": {
      "foreground": "#385e58"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#527287"
    },
    "decorator": {
      "foreground": "#8f4b10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#527287"
    },
    "enum": {
      "foreground": "#385e58"
    },
    "enumMember": {
      "foreground": "#424241"
    },
    "function": {
      "foreground": "#87470f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#87470f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#908a86"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#385e58"
    },
    "keyword": {
      "foreground": "#135fa2"
    },
    "label": {
      "foreground": "#135fa2"
    },
    "macro": {
      "foreground": "#22647e"
    },
    "method": {
      "foreground": "#87470f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#87470f"
    },
    "namespace": {
      "foreground": "#385e58"
    },
    "number": {
      "foreground": "#424241"
    },
    "operator": {
      "foreground": "#b9141b"
    },
    "parameter": {
      "foreground": "#3d5273"
    },
    "property": {
      "foreground": "#33665e"
    },
    "property.declaration": {
      "foreground": "#3d5273"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#135fa2"
    },
    "string": {
      "foreground": "#266243"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2f6a1f"
    },
    "string.regexp": {
      "foreground": "#2f6a1f"
    },
    "struct": {
      "foreground": "#385e58"
    },
    "type": {
      "foreground": "#385e58"
    },
    "type.declaration": {
      "foreground": "#385e58"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#385e58"
    },
    "variable": {
      "foreground": "#3d5273"
    },
    "variable.defaultLibrary": {
      "foreground": "#5d5d5b"
    },
    "variable.readonly": {
      "foreground": "#424241"
    },
    "variable.readonly.local": {
      "foreground": "#3d5273"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#527287"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#135fa2"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266243"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f6a1f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f6a1f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#87470f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#385e58"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#3d5273"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5d5d5b"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#385e58"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8f4b10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#87470f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#065c98"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#125a97"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#ae2b30"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#908a86"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#33665e"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#135fa2"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#908a86"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#385e58"
      }
    }
  ],
  "type": "light"
}