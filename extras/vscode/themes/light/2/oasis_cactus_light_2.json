  "name": "Oasis Cactus Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#454544"
    },
    "class": {
      "foreground": "#175c9a"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5f7760"
    },
    "decorator": {
      "foreground": "#934d10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#5f7760"
    },
    "enum": {
      "foreground": "#175c9a"
    },
    "enumMember": {
      "foreground": "#454544"
    },
    "function": {
      "foreground": "#8a490f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8a490f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#968c84"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#175c9a"
    },
    "keyword": {
      "foreground": "#3e6940"
    },
    "label": {
      "foreground": "#3e6940"
    },
    "macro": {
      "foreground": "#87550f"
    },
    "method": {
      "foreground": "#8a490f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8a490f"
    },
    "namespace": {
      "foreground": "#175c9a"
    },
    "number": {
      "foreground": "#454544"
    },
    "operator": {
      "foreground": "#be151c"
    },
    "parameter": {
      "foreground": "#44584c"
    },
    "property": {
      "foreground": "#276780"
    },
    "property.declaration": {
      "foreground": "#44584c"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#3e6940"
    },
    "string": {
      "foreground": "#286545"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#316c20"
    },
    "string.regexp": {
      "foreground": "#316c20"
    },
    "struct": {
      "foreground": "#175c9a"
    },
    "type": {
      "foreground": "#175c9a"
    },
    "type.declaration": {
      "foreground": "#175c9a"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#175c9a"
    },
    "variable": {
      "foreground": "#44584c"
    },
    "variable.defaultLibrary": {
      "foreground": "#60605e"
    },
    "variable.readonly": {
      "foreground": "#454544"
    },
    "variable.readonly.local": {
      "foreground": "#44584c"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5f7760"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3e6940"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286545"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#316c20"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#316c20"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8a490f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#175c9a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#454544"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#44584c"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#60605e"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#175c9a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#934d10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8a490f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#38663b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3b633d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#bb1e23"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#276780"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#3e6940"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#968c84"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#454544"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#175c9a"
      }
    }
  ],
  "type": "light"
}