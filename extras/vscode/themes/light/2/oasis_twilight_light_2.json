  "name": "Oasis Twilight Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#414140"
    },
    "class": {
      "foreground": "#375d57"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#716886"
    },
    "decorator": {
      "foreground": "#8d4a0f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#716886"
    },
    "enum": {
      "foreground": "#375d57"
    },
    "enumMember": {
      "foreground": "#414140"
    },
    "function": {
      "foreground": "#84460e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#84460e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#918880"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#375d57"
    },
    "keyword": {
      "foreground": "#7f18e1"
    },
    "label": {
      "foreground": "#7f18e1"
    },
    "macro": {
      "foreground": "#22627c"
    },
    "method": {
      "foreground": "#84460e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#84460e"
    },
    "namespace": {
      "foreground": "#375d57"
    },
    "number": {
      "foreground": "#414140"
    },
    "operator": {
      "foreground": "#b6141b"
    },
    "parameter": {
      "foreground": "#544975"
    },
    "property": {
      "foreground": "#32645c"
    },
    "property.declaration": {
      "foreground": "#544975"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#7f18e1"
    },
    "string": {
      "foreground": "#266142"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2f681f"
    },
    "string.regexp": {
      "foreground": "#2f681f"
    },
    "struct": {
      "foreground": "#375d57"
    },
    "type": {
      "foreground": "#375d57"
    },
    "type.declaration": {
      "foreground": "#375d57"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#375d57"
    },
    "variable": {
      "foreground": "#544975"
    },
    "variable.defaultLibrary": {
      "foreground": "#5a5c5d"
    },
    "variable.readonly": {
      "foreground": "#414140"
    },
    "variable.readonly.local": {
      "foreground": "#544975"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#716886"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7f18e1"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266142"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f681f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f681f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#84460e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#375d57"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#414140"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#544975"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5a5c5d"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#375d57"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8d4a0f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#84460e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#490599"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7717d4"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ab2a2f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#32645c"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7f18e1"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#918880"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#414140"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#375d57"
      }
    }
  ],
  "type": "light"
}