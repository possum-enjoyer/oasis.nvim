  "name": "Oasis Rose Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#424241"
    },
    "class": {
      "foreground": "#325f59"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#846474"
    },
    "decorator": {
      "foreground": "#8e4b0f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#846474"
    },
    "enum": {
      "foreground": "#325f59"
    },
    "enumMember": {
      "foreground": "#424241"
    },
    "function": {
      "foreground": "#86470f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#86470f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#928982"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#325f59"
    },
    "keyword": {
      "foreground": "#b8141b"
    },
    "label": {
      "foreground": "#b8141b"
    },
    "macro": {
      "foreground": "#22637d"
    },
    "method": {
      "foreground": "#86470f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#86470f"
    },
    "namespace": {
      "foreground": "#325f59"
    },
    "number": {
      "foreground": "#424241"
    },
    "operator": {
      "foreground": "#9f3e1a"
    },
    "parameter": {
      "foreground": "#61495c"
    },
    "property": {
      "foreground": "#35655e"
    },
    "property.declaration": {
      "foreground": "#61495c"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#b8141b"
    },
    "string": {
      "foreground": "#266243"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2f691f"
    },
    "string.regexp": {
      "foreground": "#2f691f"
    },
    "struct": {
      "foreground": "#325f59"
    },
    "type": {
      "foreground": "#325f59"
    },
    "type.declaration": {
      "foreground": "#325f59"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#325f59"
    },
    "variable": {
      "foreground": "#61495c"
    },
    "variable.defaultLibrary": {
      "foreground": "#5b5d5e"
    },
    "variable.readonly": {
      "foreground": "#424241"
    },
    "variable.readonly.local": {
      "foreground": "#61495c"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#846474"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b8141b"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266243"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f691f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f691f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#86470f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#325f59"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#61495c"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5b5d5e"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#325f59"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8e4b0f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#86470f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#990505"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ae1319"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#b51d22"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#35655e"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b8141b"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#928982"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#325f59"
      }
    }
  ],
  "type": "light"
}