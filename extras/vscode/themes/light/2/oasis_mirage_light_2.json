  "name": "Oasis Mirage Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#464644"
    },
    "class": {
      "foreground": "#175d9b"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#4a7a73"
    },
    "decorator": {
      "foreground": "#944e10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#4a7a73"
    },
    "enum": {
      "foreground": "#175d9b"
    },
    "enumMember": {
      "foreground": "#464644"
    },
    "function": {
      "foreground": "#8c4a0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8c4a0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#968d86"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#175d9b"
    },
    "keyword": {
      "foreground": "#356962"
    },
    "label": {
      "foreground": "#356962"
    },
    "macro": {
      "foreground": "#8a540f"
    },
    "method": {
      "foreground": "#8c4a0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8c4a0f"
    },
    "namespace": {
      "foreground": "#175d9b"
    },
    "number": {
      "foreground": "#464644"
    },
    "operator": {
      "foreground": "#c0151c"
    },
    "parameter": {
      "foreground": "#425858"
    },
    "property": {
      "foreground": "#1962a7"
    },
    "property.declaration": {
      "foreground": "#425858"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#356962"
    },
    "string": {
      "foreground": "#286646"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326d22"
    },
    "string.regexp": {
      "foreground": "#326d22"
    },
    "struct": {
      "foreground": "#175d9b"
    },
    "type": {
      "foreground": "#175d9b"
    },
    "type.declaration": {
      "foreground": "#175d9b"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#175d9b"
    },
    "variable": {
      "foreground": "#425858"
    },
    "variable.defaultLibrary": {
      "foreground": "#60605f"
    },
    "variable.readonly": {
      "foreground": "#464644"
    },
    "variable.readonly.local": {
      "foreground": "#425858"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a7a73"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#356962"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286646"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326d22"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326d22"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#175d9b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#464644"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#425858"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#60605f"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#175d9b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#944e10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#316e66"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#32635d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#bc1e23"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#968d86"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#1962a7"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#356962"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#968d86"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#464644"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#175d9b"
      }
    }
  ],
  "type": "light"
}