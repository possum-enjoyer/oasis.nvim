  "name": "Oasis Starlight Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#454544"
    },
    "class": {
      "foreground": "#3a625b"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#567398"
    },
    "decorator": {
      "foreground": "#934d10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#567398"
    },
    "enum": {
      "foreground": "#3a625b"
    },
    "enumMember": {
      "foreground": "#454544"
    },
    "function": {
      "foreground": "#8b490f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8b490f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#998c84"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#3a625b"
    },
    "keyword": {
      "foreground": "#1462a7"
    },
    "label": {
      "foreground": "#1462a7"
    },
    "macro": {
      "foreground": "#236782"
    },
    "method": {
      "foreground": "#8b490f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8b490f"
    },
    "namespace": {
      "foreground": "#3a625b"
    },
    "number": {
      "foreground": "#454544"
    },
    "operator": {
      "foreground": "#be151c"
    },
    "parameter": {
      "foreground": "#5b5341"
    },
    "property": {
      "foreground": "#346960"
    },
    "property.declaration": {
      "foreground": "#5b5341"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#1462a7"
    },
    "string": {
      "foreground": "#286645"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326d21"
    },
    "string.regexp": {
      "foreground": "#326d21"
    },
    "struct": {
      "foreground": "#3a625b"
    },
    "type": {
      "foreground": "#3a625b"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#3a625b"
    },
    "variable": {
      "foreground": "#5b5341"
    },
    "variable.defaultLibrary": {
      "foreground": "#60605e"
    },
    "variable.readonly": {
      "foreground": "#454544"
    },
    "variable.readonly.local": {
      "foreground": "#5b5341"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#567398"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1462a7"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286645"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326d21"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326d21"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8b490f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3a625b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#454544"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#5b5341"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#60605e"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3a625b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#934d10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8b490f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#075b98"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#135d9c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#be151c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#998c84"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#346960"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#1462a7"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#998c84"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#454544"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#3a625b"
      }
    }
  ],
  "type": "light"
}