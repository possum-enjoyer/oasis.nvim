  "name": "Oasis Night Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#383837"
    },
    "class": {
      "foreground": "#31534e"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#785d4e"
    },
    "decorator": {
      "foreground": "#7e430e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#785d4e"
    },
    "enum": {
      "foreground": "#31534e"
    },
    "enumMember": {
      "foreground": "#383837"
    },
    "function": {
      "foreground": "#6d440c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6d440c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7f7f7f"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#31534e"
    },
    "keyword": {
      "foreground": "#7e430e"
    },
    "label": {
      "foreground": "#7e430e"
    },
    "macro": {
      "foreground": "#1e586f"
    },
    "method": {
      "foreground": "#6d440c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6d440c"
    },
    "namespace": {
      "foreground": "#31534e"
    },
    "number": {
      "foreground": "#383837"
    },
    "operator": {
      "foreground": "#a51218"
    },
    "parameter": {
      "foreground": "#54432d"
    },
    "property": {
      "foreground": "#2e5953"
    },
    "property.declaration": {
      "foreground": "#54432d"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#7e430e"
    },
    "string": {
      "foreground": "#22563b"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#295d1c"
    },
    "string.regexp": {
      "foreground": "#295d1c"
    },
    "struct": {
      "foreground": "#31534e"
    },
    "type": {
      "foreground": "#31534e"
    },
    "type.declaration": {
      "foreground": "#31534e"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#31534e"
    },
    "variable": {
      "foreground": "#54432d"
    },
    "variable.defaultLibrary": {
      "foreground": "#515253"
    },
    "variable.readonly": {
      "foreground": "#383837"
    },
    "variable.readonly.local": {
      "foreground": "#54432d"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#785d4e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7e430e"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#22563b"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#295d1c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#295d1c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6d440c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#31534e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#383837"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#54432d"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#515253"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#31534e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7e430e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6d440c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#851a1a"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#763e0d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#9a262b"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7f7f7f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2e5953"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7e430e"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7f7f7f"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#383837"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#31534e"
      }
    }
  ],
  "type": "light"
}