  "name": "Oasis Sol Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#40403f"
    },
    "class": {
      "foreground": "#315d58"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#7e6663"
    },
    "decorator": {
      "foreground": "#8c4a0f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#7e6663"
    },
    "enum": {
      "foreground": "#315d58"
    },
    "enumMember": {
      "foreground": "#40403f"
    },
    "function": {
      "foreground": "#84450e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#84450e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#888888"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#315d58"
    },
    "keyword": {
      "foreground": "#ad262a"
    },
    "label": {
      "foreground": "#ad262a"
    },
    "macro": {
      "foreground": "#21627b"
    },
    "method": {
      "foreground": "#84450e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#84450e"
    },
    "namespace": {
      "foreground": "#315d58"
    },
    "number": {
      "foreground": "#40403f"
    },
    "operator": {
      "foreground": "#9c3d19"
    },
    "parameter": {
      "foreground": "#793e33"
    },
    "property": {
      "foreground": "#34635c"
    },
    "property.declaration": {
      "foreground": "#793e33"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#ad262a"
    },
    "string": {
      "foreground": "#266042"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2e671f"
    },
    "string.regexp": {
      "foreground": "#2e671f"
    },
    "struct": {
      "foreground": "#315d58"
    },
    "type": {
      "foreground": "#315d58"
    },
    "type.declaration": {
      "foreground": "#315d58"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#315d58"
    },
    "variable": {
      "foreground": "#793e33"
    },
    "variable.defaultLibrary": {
      "foreground": "#5a5b5c"
    },
    "variable.readonly": {
      "foreground": "#40403f"
    },
    "variable.readonly.local": {
      "foreground": "#793e33"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7e6663"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ad262a"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266042"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2e671f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e671f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#84450e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#315d58"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#40403f"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#793e33"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5a5b5c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#315d58"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#84450e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#851a1a"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ab1319"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#a2361a"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#34635c"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ad262a"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#40403f"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#315d58"
      }
    }
  ],
  "type": "light"
}