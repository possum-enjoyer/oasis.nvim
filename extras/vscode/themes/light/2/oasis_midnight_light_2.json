  "name": "Oasis Midnight Light 2",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#424241"
    },
    "class": {
      "foreground": "#325f59"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#626e81"
    },
    "decorator": {
      "foreground": "#8f4a10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#626e81"
    },
    "enum": {
      "foreground": "#325f59"
    },
    "enumMember": {
      "foreground": "#424241"
    },
    "function": {
      "foreground": "#86470f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#86470f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8f8a84"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#325f59"
    },
    "keyword": {
      "foreground": "#b0272c"
    },
    "label": {
      "foreground": "#b0272c"
    },
    "macro": {
      "foreground": "#22637d"
    },
    "method": {
      "foreground": "#86470f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#86470f"
    },
    "namespace": {
      "foreground": "#325f59"
    },
    "number": {
      "foreground": "#424241"
    },
    "operator": {
      "foreground": "#9f3e1a"
    },
    "parameter": {
      "foreground": "#584f48"
    },
    "property": {
      "foreground": "#35655e"
    },
    "property.declaration": {
      "foreground": "#584f48"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#b0272c"
    },
    "string": {
      "foreground": "#266243"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2f691f"
    },
    "string.regexp": {
      "foreground": "#2f691f"
    },
    "struct": {
      "foreground": "#325f59"
    },
    "type": {
      "foreground": "#325f59"
    },
    "type.declaration": {
      "foreground": "#325f59"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#325f59"
    },
    "variable": {
      "foreground": "#584f48"
    },
    "variable.defaultLibrary": {
      "foreground": "#5b5d5e"
    },
    "variable.readonly": {
      "foreground": "#424241"
    },
    "variable.readonly.local": {
      "foreground": "#584f48"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#626e81"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b0272c"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266243"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f691f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f691f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#86470f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#325f59"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#584f48"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5b5d5e"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#325f59"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8f4a10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#86470f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#762828"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ae1319"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#ae2b30"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8f8a84"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#35655e"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b0272c"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8f8a84"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#325f59"
      }
    }
  ],
  "type": "light"
}