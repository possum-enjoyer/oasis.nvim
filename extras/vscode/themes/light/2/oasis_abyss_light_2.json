      ],
      "settings": {
        "foreground": "#938a83"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#434342"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#33605a"
