  "name": "Oasis Starlight Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3a3939"
    },
    "class": {
      "foreground": "#32544f"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#4d6687"
    },
    "decorator": {
      "foreground": "#81430e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#4d6687"
    },
    "enum": {
      "foreground": "#32544f"
    },
    "enumMember": {
      "foreground": "#3a3939"
    },
    "function": {
      "foreground": "#78400d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#78400d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8d7d74"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#32544f"
    },
    "keyword": {
      "foreground": "#125592"
    },
    "label": {
      "foreground": "#125592"
    },
    "macro": {
      "foreground": "#205a71"
    },
    "method": {
      "foreground": "#78400d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#78400d"
    },
    "namespace": {
      "foreground": "#32544f"
    },
    "number": {
      "foreground": "#3a3939"
    },
    "operator": {
      "foreground": "#a81218"
    },
    "parameter": {
      "foreground": "#4d4738"
    },
    "property": {
      "foreground": "#2e5b55"
    },
    "property.declaration": {
      "foreground": "#4d4738"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#125592"
    },
    "string": {
      "foreground": "#22583c"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2b5f1d"
    },
    "string.regexp": {
      "foreground": "#2b5f1d"
    },
    "struct": {
      "foreground": "#32544f"
    },
    "type": {
      "foreground": "#32544f"
    },
    "type.declaration": {
      "foreground": "#32544f"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#32544f"
    },
    "variable": {
      "foreground": "#4d4738"
    },
    "variable.defaultLibrary": {
      "foreground": "#545452"
    },
    "variable.readonly": {
      "foreground": "#3a3939"
    },
    "variable.readonly.local": {
      "foreground": "#4d4738"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4d6687"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#125592"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#22583c"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2b5f1d"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b5f1d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#78400d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#32544f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3a3939"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4d4738"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#545452"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#32544f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#81430e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#78400d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#024a7e"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#115089"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#a81218"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2e5b55"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#125592"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8d7d74"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3a3939"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#32544f"
      }
    }
  ],
  "type": "light"
}