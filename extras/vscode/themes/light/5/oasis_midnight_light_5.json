  "name": "Oasis Midnight Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#323131"
    },
    "class": {
      "foreground": "#294d49"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#545d6e"
    },
    "decorator": {
      "foreground": "#763d0d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#545d6e"
    },
    "enum": {
      "foreground": "#294d49"
    },
    "enumMember": {
      "foreground": "#323131"
    },
    "function": {
      "foreground": "#6d3a0c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6d3a0c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7c7771"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#294d49"
    },
    "keyword": {
      "foreground": "#912125"
    },
    "label": {
      "foreground": "#912125"
    },
    "macro": {
      "foreground": "#1d5268"
    },
    "method": {
      "foreground": "#6d3a0c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6d3a0c"
    },
    "namespace": {
      "foreground": "#294d49"
    },
    "number": {
      "foreground": "#323131"
    },
    "operator": {
      "foreground": "#833316"
    },
    "parameter": {
      "foreground": "#473f3a"
    },
    "property": {
      "foreground": "#2c534e"
    },
    "property.declaration": {
      "foreground": "#473f3a"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#912125"
    },
    "string": {
      "foreground": "#1f5037"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#27571a"
    },
    "string.regexp": {
      "foreground": "#27571a"
    },
    "struct": {
      "foreground": "#294d49"
    },
    "type": {
      "foreground": "#294d49"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#294d49"
    },
    "variable": {
      "foreground": "#473f3a"
    },
    "variable.defaultLibrary": {
      "foreground": "#4b4d4d"
    },
    "variable.readonly": {
      "foreground": "#323131"
    },
    "variable.readonly.local": {
      "foreground": "#473f3a"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#545d6e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#912125"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1f5037"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#27571a"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#27571a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6d3a0c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#294d49"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#323131"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#473f3a"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4b4d4d"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#294d49"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#763d0d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6d3a0c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#621e1e"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#901015"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#902327"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7c7771"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2c534e"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#912125"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7c7771"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#323131"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#294d49"
      }
    }
  ],
  "type": "light"
}