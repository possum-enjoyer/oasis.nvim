  "name": "Oasis Desert Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#363535"
    },
    "class": {
      "foreground": "#2b514c"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#51626f"
    },
    "decorator": {
      "foreground": "#7a410d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#51626f"
    },
    "enum": {
      "foreground": "#2b514c"
    },
    "enumMember": {
      "foreground": "#363535"
    },
    "function": {
      "foreground": "#68430b"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#68430b"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#847a71"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2b514c"
    },
    "keyword": {
      "foreground": "#595016"
    },
    "label": {
      "foreground": "#595016"
    },
    "macro": {
      "foreground": "#1e556c"
    },
    "method": {
      "foreground": "#68430b"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#68430b"
    },
    "namespace": {
      "foreground": "#2b514c"
    },
    "number": {
      "foreground": "#363535"
    },
    "operator": {
      "foreground": "#893617"
    },
    "parameter": {
      "foreground": "#504132"
    },
    "property": {
      "foreground": "#2c5751"
    },
    "property.declaration": {
      "foreground": "#504132"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#595016"
    },
    "string": {
      "foreground": "#1e5436"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#285b1b"
    },
    "string.regexp": {
      "foreground": "#285b1b"
    },
    "struct": {
      "foreground": "#2b514c"
    },
    "type": {
      "foreground": "#2b514c"
    },
    "type.declaration": {
      "foreground": "#2b514c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2b514c"
    },
    "variable": {
      "foreground": "#504132"
    },
    "variable.defaultLibrary": {
      "foreground": "#4f5050"
    },
    "variable.readonly": {
      "foreground": "#363535"
    },
    "variable.readonly.local": {
      "foreground": "#504132"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#51626f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#595016"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1e5436"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#285b1b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#285b1b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#68430b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2b514c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#363535"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#504132"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4f5050"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2b514c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7a410d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#68430b"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#621e1e"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#504b25"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#962529"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#847a71"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2c5751"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#595016"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#847a71"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#363535"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2b514c"
      }
    }
  ],
  "type": "light"
}