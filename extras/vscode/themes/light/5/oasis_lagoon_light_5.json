  "name": "Oasis Lagoon Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#313030"
    },
    "class": {
      "foreground": "#2d4c47"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#465f71"
    },
    "decorator": {
      "foreground": "#753d0d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#465f71"
    },
    "enum": {
      "foreground": "#2d4c47"
    },
    "enumMember": {
      "foreground": "#313030"
    },
    "function": {
      "foreground": "#6d390c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6d390c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7b7671"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2d4c47"
    },
    "keyword": {
      "foreground": "#104d84"
    },
    "label": {
      "foreground": "#104d84"
    },
    "macro": {
      "foreground": "#1c5167"
    },
    "method": {
      "foreground": "#6d390c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6d390c"
    },
    "namespace": {
      "foreground": "#2d4c47"
    },
    "number": {
      "foreground": "#313030"
    },
    "operator": {
      "foreground": "#981116"
    },
    "parameter": {
      "foreground": "#30405b"
    },
    "property": {
      "foreground": "#2a534d"
    },
    "property.declaration": {
      "foreground": "#30405b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#104d84"
    },
    "string": {
      "foreground": "#1f4f36"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#26561a"
    },
    "string.regexp": {
      "foreground": "#26561a"
    },
    "struct": {
      "foreground": "#2d4c47"
    },
    "type": {
      "foreground": "#2d4c47"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2d4c47"
    },
    "variable": {
      "foreground": "#30405b"
    },
    "variable.defaultLibrary": {
      "foreground": "#4c4c4a"
    },
    "variable.readonly": {
      "foreground": "#313030"
    },
    "variable.readonly.local": {
      "foreground": "#30405b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#465f71"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#104d84"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1f4f36"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#26561a"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#26561a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6d390c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2d4c47"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#313030"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#30405b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4c4c4a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2d4c47"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#753d0d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6d390c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#014b7e"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#0f487b"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#8f2327"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7b7671"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2a534d"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#104d84"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7b7671"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#313030"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2d4c47"
      }
    }
  ],
  "type": "light"
}