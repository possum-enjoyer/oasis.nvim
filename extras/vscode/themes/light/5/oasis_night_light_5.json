  "name": "Oasis Night Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#2e2e2d"
    },
    "class": {
      "foreground": "#2c4a45"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#6d5547"
    },
    "decorator": {
      "foreground": "#723b0c"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#6d5547"
    },
    "enum": {
      "foreground": "#2c4a45"
    },
    "enumMember": {
      "foreground": "#2e2e2d"
    },
    "function": {
      "foreground": "#603c0a"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#603c0a"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#757575"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2c4a45"
    },
    "keyword": {
      "foreground": "#713c0c"
    },
    "label": {
      "foreground": "#713c0c"
    },
    "macro": {
      "foreground": "#1c4f64"
    },
    "method": {
      "foreground": "#603c0a"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#603c0a"
    },
    "namespace": {
      "foreground": "#2c4a45"
    },
    "number": {
      "foreground": "#2e2e2d"
    },
    "operator": {
      "foreground": "#941015"
    },
    "parameter": {
      "foreground": "#4b3b28"
    },
    "property": {
      "foreground": "#2a504b"
    },
    "property.declaration": {
      "foreground": "#4b3b28"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#713c0c"
    },
    "string": {
      "foreground": "#1e4d34"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#255319"
    },
    "string.regexp": {
      "foreground": "#255319"
    },
    "struct": {
      "foreground": "#2c4a45"
    },
    "type": {
      "foreground": "#2c4a45"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2c4a45"
    },
    "variable": {
      "foreground": "#4b3b28"
    },
    "variable.defaultLibrary": {
      "foreground": "#484a4a"
    },
    "variable.readonly": {
      "foreground": "#2e2e2d"
    },
    "variable.readonly.local": {
      "foreground": "#4b3b28"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6d5547"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#713c0c"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1e4d34"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#255319"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#255319"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#603c0a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2c4a45"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e2e2d"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4b3b28"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#484a4a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2c4a45"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#723b0c"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#603c0a"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6e1212"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6a370b"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#8b2226"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#757575"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2a504b"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#713c0c"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#757575"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#2e2e2d"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2c4a45"
      }
    }
  ],
  "type": "light"
}