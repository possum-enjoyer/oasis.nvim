  "name": "Oasis Dune Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3b3939"
    },
    "class": {
      "foreground": "#335550"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#6e635b"
    },
    "decorator": {
      "foreground": "#83440e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#6e635b"
    },
    "enum": {
      "foreground": "#335550"
    },
    "enumMember": {
      "foreground": "#3b3939"
    },
    "function": {
      "foreground": "#7b400d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7b400d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#818181"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#335550"
    },
    "keyword": {
      "foreground": "#5e5517"
    },
    "label": {
      "foreground": "#5e5517"
    },
    "macro": {
      "foreground": "#205a72"
    },
    "method": {
      "foreground": "#7b400d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7b400d"
    },
    "namespace": {
      "foreground": "#335550"
    },
    "number": {
      "foreground": "#3b3939"
    },
    "operator": {
      "foreground": "#a91218"
    },
    "parameter": {
      "foreground": "#4a4940"
    },
    "property": {
      "foreground": "#305c56"
    },
    "property.declaration": {
      "foreground": "#4a4940"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#5e5517"
    },
    "string": {
      "foreground": "#22593d"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2b601c"
    },
    "string.regexp": {
      "foreground": "#2b601c"
    },
    "struct": {
      "foreground": "#335550"
    },
    "type": {
      "foreground": "#335550"
    },
    "type.declaration": {
      "foreground": "#335550"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#335550"
    },
    "variable": {
      "foreground": "#4a4940"
    },
    "variable.defaultLibrary": {
      "foreground": "#535555"
    },
    "variable.readonly": {
      "foreground": "#3b3939"
    },
    "variable.readonly.local": {
      "foreground": "#4a4940"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6e635b"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5e5517"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#22593d"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2b601c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b601c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7b400d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#335550"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3b3939"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4a4940"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#535555"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#335550"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#83440e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7b400d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#585527"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#54502d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#a51b1f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#305c56"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#5e5517"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#818181"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3b3939"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#335550"
      }
    }
  ],
  "type": "light"
}