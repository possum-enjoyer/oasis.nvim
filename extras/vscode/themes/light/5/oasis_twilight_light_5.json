  "name": "Oasis Twilight Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#282727"
    },
    "class": {
      "foreground": "#28443f"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#595069"
    },
    "decorator": {
      "foreground": "#6a370b"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#595069"
    },
    "enum": {
      "foreground": "#28443f"
    },
    "enumMember": {
      "foreground": "#282727"
    },
    "function": {
      "foreground": "#62330b"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#62330b"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#756e67"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#28443f"
    },
    "keyword": {
      "foreground": "#6012a9"
    },
    "label": {
      "foreground": "#6012a9"
    },
    "macro": {
      "foreground": "#1a495c"
    },
    "method": {
      "foreground": "#62330b"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#62330b"
    },
    "namespace": {
      "foreground": "#28443f"
    },
    "number": {
      "foreground": "#282727"
    },
    "operator": {
      "foreground": "#890f14"
    },
    "parameter": {
      "foreground": "#3b3351"
    },
    "property": {
      "foreground": "#254a45"
    },
    "property.declaration": {
      "foreground": "#3b3351"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#6012a9"
    },
    "string": {
      "foreground": "#1b4630"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#224d17"
    },
    "string.regexp": {
      "foreground": "#224d17"
    },
    "struct": {
      "foreground": "#28443f"
    },
    "type": {
      "foreground": "#28443f"
    },
    "type.declaration": {
      "foreground": "#28443f"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#28443f"
    },
    "variable": {
      "foreground": "#3b3351"
    },
    "variable.defaultLibrary": {
      "foreground": "#434444"
    },
    "variable.readonly": {
      "foreground": "#282727"
    },
    "variable.readonly.local": {
      "foreground": "#3b3351"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#595069"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6012a9"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1b4630"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#224d17"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#224d17"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#62330b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#28443f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#282727"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#3b3351"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#434444"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#28443f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6a370b"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#62330b"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#3b0080"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#59119c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#811f23"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#254a45"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6012a9"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#756e67"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#282727"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#28443f"
      }
    }
  ],
  "type": "light"
}