  "name": "Oasis Sol Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#2b2a2a"
    },
    "class": {
      "foreground": "#254742"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#665250"
    },
    "decorator": {
      "foreground": "#6d390c"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#665250"
    },
    "enum": {
      "foreground": "#254742"
    },
    "enumMember": {
      "foreground": "#2b2a2a"
    },
    "function": {
      "foreground": "#64350b"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#64350b"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#727272"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#254742"
    },
    "keyword": {
      "foreground": "#871f20"
    },
    "label": {
      "foreground": "#871f20"
    },
    "macro": {
      "foreground": "#1b4c5f"
    },
    "method": {
      "foreground": "#64350b"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#64350b"
    },
    "namespace": {
      "foreground": "#254742"
    },
    "number": {
      "foreground": "#2b2a2a"
    },
    "operator": {
      "foreground": "#792f14"
    },
    "parameter": {
      "foreground": "#5b2e26"
    },
    "property": {
      "foreground": "#284d48"
    },
    "property.declaration": {
      "foreground": "#5b2e26"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#871f20"
    },
    "string": {
      "foreground": "#1c4932"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#245018"
    },
    "string.regexp": {
      "foreground": "#245018"
    },
    "struct": {
      "foreground": "#254742"
    },
    "type": {
      "foreground": "#254742"
    },
    "type.declaration": {
      "foreground": "#254742"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#254742"
    },
    "variable": {
      "foreground": "#5b2e26"
    },
    "variable.defaultLibrary": {
      "foreground": "#454747"
    },
    "variable.readonly": {
      "foreground": "#2b2a2a"
    },
    "variable.readonly.local": {
      "foreground": "#5b2e26"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#665250"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#871f20"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1c4932"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#245018"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#245018"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#64350b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#254742"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b2a2a"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#5b2e26"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#454747"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#254742"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6d390c"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#64350b"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6e1212"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#840e13"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#7f2a15"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#727272"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#284d48"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#871f20"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#727272"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#2b2a2a"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#254742"
      }
    }
  ],
  "type": "light"
}