  "name": "Oasis Rose Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#2f2e2e"
    },
    "class": {
      "foreground": "#274a46"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#6c525f"
    },
    "decorator": {
      "foreground": "#723b0c"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#6c525f"
    },
    "enum": {
      "foreground": "#274a46"
    },
    "enumMember": {
      "foreground": "#2f2e2e"
    },
    "function": {
      "foreground": "#69370b"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#69370b"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7b736c"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#274a46"
    },
    "keyword": {
      "foreground": "#941015"
    },
    "label": {
      "foreground": "#941015"
    },
    "macro": {
      "foreground": "#1c4f63"
    },
    "method": {
      "foreground": "#69370b"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#69370b"
    },
    "namespace": {
      "foreground": "#274a46"
    },
    "number": {
      "foreground": "#2f2e2e"
    },
    "operator": {
      "foreground": "#7e3115"
    },
    "parameter": {
      "foreground": "#4a3845"
    },
    "property": {
      "foreground": "#2a504b"
    },
    "property.declaration": {
      "foreground": "#4a3845"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#941015"
    },
    "string": {
      "foreground": "#1e4d34"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#255319"
    },
    "string.regexp": {
      "foreground": "#255319"
    },
    "struct": {
      "foreground": "#274a46"
    },
    "type": {
      "foreground": "#274a46"
    },
    "type.declaration": {
      "foreground": "#274a46"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#274a46"
    },
    "variable": {
      "foreground": "#4a3845"
    },
    "variable.defaultLibrary": {
      "foreground": "#484a4a"
    },
    "variable.readonly": {
      "foreground": "#2f2e2e"
    },
    "variable.readonly.local": {
      "foreground": "#4a3845"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6c525f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#941015"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1e4d34"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#255319"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#255319"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#69370b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#274a46"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f2e2e"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4a3845"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#484a4a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#274a46"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#723b0c"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#69370b"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8a0f14"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#91181b"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2a504b"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#941015"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7b736c"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#2f2e2e"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#274a46"
      }
    }
  ],
  "type": "light"
}