  "name": "Oasis Cactus Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3c3a3a"
    },
    "class": {
      "foreground": "#155288"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#556b57"
    },
    "decorator": {
      "foreground": "#84440e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#556b57"
    },
    "enum": {
      "foreground": "#155288"
    },
    "enumMember": {
      "foreground": "#3c3a3a"
    },
    "function": {
      "foreground": "#7b410d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7b410d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8b8077"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#155288"
    },
    "keyword": {
      "foreground": "#375e39"
    },
    "label": {
      "foreground": "#375e39"
    },
    "macro": {
      "foreground": "#784b0d"
    },
    "method": {
      "foreground": "#7b410d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7b410d"
    },
    "namespace": {
      "foreground": "#155288"
    },
    "number": {
      "foreground": "#3c3a3a"
    },
    "operator": {
      "foreground": "#ab1319"
    },
    "parameter": {
      "foreground": "#3c4d44"
    },
    "property": {
      "foreground": "#225c73"
    },
    "property.declaration": {
      "foreground": "#3c4d44"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#375e39"
    },
    "string": {
      "foreground": "#235a3d"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2b611d"
    },
    "string.regexp": {
      "foreground": "#2b611d"
    },
    "struct": {
      "foreground": "#155288"
    },
    "type": {
      "foreground": "#155288"
    },
    "type.declaration": {
      "foreground": "#155288"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#155288"
    },
    "variable": {
      "foreground": "#3c4d44"
    },
    "variable.defaultLibrary": {
      "foreground": "#555553"
    },
    "variable.readonly": {
      "foreground": "#3c3a3a"
    },
    "variable.readonly.local": {
      "foreground": "#3c4d44"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#556b57"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#375e39"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#235a3d"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2b611d"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b611d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7b410d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#155288"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3c3a3a"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#3c4d44"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#555553"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#155288"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#84440e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7b410d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2c532e"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#345835"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#a71c20"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#225c73"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#375e39"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8b8077"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3c3a3a"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#155288"
      }
    }
  ],
  "type": "light"
}