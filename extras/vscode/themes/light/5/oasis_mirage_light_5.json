  "name": "Oasis Mirage Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3f3d3d"
    },
    "class": {
      "foreground": "#15558d"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#43716a"
    },
    "decorator": {
      "foreground": "#89470f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#43716a"
    },
    "enum": {
      "foreground": "#15558d"
    },
    "enumMember": {
      "foreground": "#3f3d3d"
    },
    "function": {
      "foreground": "#7f430e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7f430e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8d847c"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#15558d"
    },
    "keyword": {
      "foreground": "#31605a"
    },
    "label": {
      "foreground": "#31605a"
    },
    "macro": {
      "foreground": "#7f4d0e"
    },
    "method": {
      "foreground": "#7f430e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7f430e"
    },
    "namespace": {
      "foreground": "#15558d"
    },
    "number": {
      "foreground": "#3f3d3d"
    },
    "operator": {
      "foreground": "#b01319"
    },
    "parameter": {
      "foreground": "#3c5050"
    },
    "property": {
      "foreground": "#175a98"
    },
    "property.declaration": {
      "foreground": "#3c5050"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#31605a"
    },
    "string": {
      "foreground": "#245d40"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2e641f"
    },
    "string.regexp": {
      "foreground": "#2e641f"
    },
    "struct": {
      "foreground": "#15558d"
    },
    "type": {
      "foreground": "#15558d"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#15558d"
    },
    "variable": {
      "foreground": "#3c5050"
    },
    "variable.defaultLibrary": {
      "foreground": "#585856"
    },
    "variable.readonly": {
      "foreground": "#3f3d3d"
    },
    "variable.readonly.local": {
      "foreground": "#3c5050"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#43716a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#31605a"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#245d40"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2e641f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e641f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7f430e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#15558d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3f3d3d"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#3c5050"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#585856"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#15558d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#89470f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7f430e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#265a53"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e5a55"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#ad1c21"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8d847c"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#175a98"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#31605a"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8d847c"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3f3d3d"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#15558d"
      }
    }
  ],
  "type": "light"
}