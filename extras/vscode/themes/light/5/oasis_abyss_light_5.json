  "name": "Oasis Abyss Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#343333"
    },
    "class": {
      "foreground": "#2a504b"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#526168"
    },
    "decorator": {
      "foreground": "#7a3f0d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#526168"
    },
    "enum": {
      "foreground": "#2a504b"
    },
    "enumMember": {
      "foreground": "#343333"
    },
    "function": {
      "foreground": "#703c0c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#703c0c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#827872"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2a504b"
    },
    "keyword": {
      "foreground": "#981e22"
    },
    "label": {
      "foreground": "#981e22"
    },
    "macro": {
      "foreground": "#22546c"
    },
    "method": {
      "foreground": "#703c0c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#703c0c"
    },
    "namespace": {
      "foreground": "#2a504b"
    },
    "number": {
      "foreground": "#343333"
    },
    "operator": {
      "foreground": "#8b3117"
    },
    "parameter": {
      "foreground": "#48413b"
    },
    "property": {
      "foreground": "#32544f"
    },
    "property.declaration": {
      "foreground": "#48413b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#981e22"
    },
    "string": {
      "foreground": "#205238"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#28591b"
    },
    "string.regexp": {
      "foreground": "#28591b"
    },
    "struct": {
      "foreground": "#2a504b"
    },
    "type": {
      "foreground": "#2a504b"
    },
    "type.declaration": {
      "foreground": "#2a504b"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2a504b"
    },
    "variable": {
      "foreground": "#48413b"
    },
    "variable.defaultLibrary": {
      "foreground": "#4d4f4f"
    },
    "variable.readonly": {
      "foreground": "#343333"
    },
    "variable.readonly.local": {
      "foreground": "#48413b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#526168"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#981e22"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#205238"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#28591b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#28591b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#703c0c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2a504b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#343333"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#48413b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4d4f4f"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2a504b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7a3f0d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#703c0c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#621e1e"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#892428"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8d2c30"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#32544f"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#981e22"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#827872"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#343333"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2a504b"
      }
    }
  ],
  "type": "light"
}