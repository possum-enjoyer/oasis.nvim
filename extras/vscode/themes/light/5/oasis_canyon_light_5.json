  "name": "Oasis Canyon Light 5",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#353534"
    },
    "class": {
      "foreground": "#30504b"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#755a4b"
    },
    "decorator": {
      "foreground": "#7c400d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#755a4b"
    },
    "enum": {
      "foreground": "#30504b"
    },
    "enumMember": {
      "foreground": "#353534"
    },
    "function": {
      "foreground": "#69420b"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#69420b"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7c7c7c"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#30504b"
    },
    "keyword": {
      "foreground": "#7a410d"
    },
    "label": {
      "foreground": "#7a410d"
    },
    "macro": {
      "foreground": "#1e556c"
    },
    "method": {
      "foreground": "#69420b"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#69420b"
    },
    "namespace": {
      "foreground": "#30504b"
    },
    "number": {
      "foreground": "#353534"
    },
    "operator": {
      "foreground": "#a01117"
    },
    "parameter": {
      "foreground": "#52412d"
    },
    "property": {
      "foreground": "#2e5751"
    },
    "property.declaration": {
      "foreground": "#52412d"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#7a410d"
    },
    "string": {
      "foreground": "#205439"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#285b1b"
    },
    "string.regexp": {
      "foreground": "#285b1b"
    },
    "struct": {
      "foreground": "#30504b"
    },
    "type": {
      "foreground": "#30504b"
    },
    "type.declaration": {
      "foreground": "#30504b"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#30504b"
    },
    "variable": {
      "foreground": "#52412d"
    },
    "variable.defaultLibrary": {
      "foreground": "#4f5050"
    },
    "variable.readonly": {
      "foreground": "#353534"
    },
    "variable.readonly.local": {
      "foreground": "#52412d"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#755a4b"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7a410d"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#205439"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#285b1b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#285b1b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#69420b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#30504b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#353534"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#52412d"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4f5050"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#30504b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7c400d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#69420b"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#803f00"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#733c0d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#962529"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2e5751"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7a410d"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#353534"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#30504b"
      }
    }
  ],
  "type": "light"
}