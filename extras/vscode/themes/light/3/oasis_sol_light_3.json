  "name": "Oasis Sol Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#383837"
    },
    "class": {
      "foreground": "#2d5450"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#755f5b"
    },
    "decorator": {
      "foreground": "#80430e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#755f5b"
    },
    "enum": {
      "foreground": "#2d5450"
    },
    "enumMember": {
      "foreground": "#383837"
    },
    "function": {
      "foreground": "#783f0d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#783f0d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#808080"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2d5450"
    },
    "keyword": {
      "foreground": "#9f2326"
    },
    "label": {
      "foreground": "#9f2326"
    },
    "macro": {
      "foreground": "#1f5970"
    },
    "method": {
      "foreground": "#783f0d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#783f0d"
    },
    "namespace": {
      "foreground": "#2d5450"
    },
    "number": {
      "foreground": "#383837"
    },
    "operator": {
      "foreground": "#8e3818"
    },
    "parameter": {
      "foreground": "#6d382e"
    },
    "property": {
      "foreground": "#2f5a54"
    },
    "property.declaration": {
      "foreground": "#6d382e"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#9f2326"
    },
    "string": {
      "foreground": "#22583b"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2a5e1c"
    },
    "string.regexp": {
      "foreground": "#2a5e1c"
    },
    "struct": {
      "foreground": "#2d5450"
    },
    "type": {
      "foreground": "#2d5450"
    },
    "type.declaration": {
      "foreground": "#2d5450"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2d5450"
    },
    "variable": {
      "foreground": "#6d382e"
    },
    "variable.defaultLibrary": {
      "foreground": "#525354"
    },
    "variable.readonly": {
      "foreground": "#383837"
    },
    "variable.readonly.local": {
      "foreground": "#6d382e"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#755f5b"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9f2326"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#22583b"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2a5e1c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2a5e1c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#783f0d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2d5450"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#383837"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#6d382e"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#525354"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2d5450"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#80430e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#783f0d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7d1717"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#9c1116"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#953219"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2f5a54"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9f2326"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#383837"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2d5450"
      }
    }
  ],
  "type": "light"
}