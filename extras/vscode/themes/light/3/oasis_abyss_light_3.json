  "name": "Oasis Abyss Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3d3d3c"
    },
    "class": {
      "foreground": "#2f5a55"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5b6b72"
    },
    "decorator": {
      "foreground": "#88470f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#5b6b72"
    },
    "enum": {
      "foreground": "#2f5a55"
    },
    "enumMember": {
      "foreground": "#3d3d3c"
    },
    "function": {
      "foreground": "#80430e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#80430e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8d837d"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2f5a55"
    },
    "keyword": {
      "foreground": "#aa2126"
    },
    "label": {
      "foreground": "#aa2126"
    },
    "macro": {
      "foreground": "#265e79"
    },
    "method": {
      "foreground": "#80430e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#80430e"
    },
    "namespace": {
      "foreground": "#2f5a55"
    },
    "number": {
      "foreground": "#3d3d3c"
    },
    "operator": {
      "foreground": "#9b371a"
    },
    "parameter": {
      "foreground": "#524b43"
    },
    "property": {
      "foreground": "#3a5f5a"
    },
    "property.declaration": {
      "foreground": "#524b43"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#aa2126"
    },
    "string": {
      "foreground": "#245d3f"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2d641e"
    },
    "string.regexp": {
      "foreground": "#2d641e"
    },
    "struct": {
      "foreground": "#2f5a55"
    },
    "type": {
      "foreground": "#2f5a55"
    },
    "type.declaration": {
      "foreground": "#2f5a55"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2f5a55"
    },
    "variable": {
      "foreground": "#524b43"
    },
    "variable.defaultLibrary": {
      "foreground": "#575859"
    },
    "variable.readonly": {
      "foreground": "#3d3d3c"
    },
    "variable.readonly.local": {
      "foreground": "#524b43"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5b6b72"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#aa2126"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#245d3f"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2d641e"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2d641e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#80430e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2f5a55"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3d3d3c"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#524b43"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#575859"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2f5a55"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#88470f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#80430e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#702424"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#992a2d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9d3236"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3a5f5a"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#aa2126"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8d837d"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3d3d3c"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2f5a55"
      }
    }
  ],
  "type": "light"
}