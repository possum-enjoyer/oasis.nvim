  "name": "Oasis Starlight Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#41413f"
    },
    "class": {
      "foreground": "#385c57"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#526e92"
    },
    "decorator": {
      "foreground": "#8d4a0f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#526e92"
    },
    "enum": {
      "foreground": "#385c57"
    },
    "enumMember": {
      "foreground": "#41413f"
    },
    "function": {
      "foreground": "#84460e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#84460e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#95867f"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#385c57"
    },
    "keyword": {
      "foreground": "#135d9e"
    },
    "label": {
      "foreground": "#135d9e"
    },
    "macro": {
      "foreground": "#22627b"
    },
    "method": {
      "foreground": "#84460e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#84460e"
    },
    "namespace": {
      "foreground": "#385c57"
    },
    "number": {
      "foreground": "#41413f"
    },
    "operator": {
      "foreground": "#b61419"
    },
    "parameter": {
      "foreground": "#564f3e"
    },
    "property": {
      "foreground": "#32645c"
    },
    "property.declaration": {
      "foreground": "#564f3e"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#135d9e"
    },
    "string": {
      "foreground": "#256042"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2f671f"
    },
    "string.regexp": {
      "foreground": "#2f671f"
    },
    "struct": {
      "foreground": "#385c57"
    },
    "type": {
      "foreground": "#385c57"
    },
    "type.declaration": {
      "foreground": "#385c57"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#385c57"
    },
    "variable": {
      "foreground": "#564f3e"
    },
    "variable.defaultLibrary": {
      "foreground": "#5b5b5a"
    },
    "variable.readonly": {
      "foreground": "#41413f"
    },
    "variable.readonly.local": {
      "foreground": "#564f3e"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#526e92"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#135d9e"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#256042"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f671f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f671f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#84460e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#385c57"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#41413f"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#564f3e"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5b5b5a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#385c57"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8d4a0f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#84460e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#05558f"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#125895"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#b61419"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#95867f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#32645c"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#135d9e"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#95867f"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#41413f"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#385c57"
      }
    }
  ],
  "type": "light"
}