  "name": "Oasis Lagoon Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3b3b3a"
    },
    "class": {
      "foreground": "#345652"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#4c6a7e"
    },
    "decorator": {
      "foreground": "#84450e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#4c6a7e"
    },
    "enum": {
      "foreground": "#345652"
    },
    "enumMember": {
      "foreground": "#3b3b3a"
    },
    "function": {
      "foreground": "#7c410e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7c410e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#87817c"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#345652"
    },
    "keyword": {
      "foreground": "#125895"
    },
    "label": {
      "foreground": "#125895"
    },
    "macro": {
      "foreground": "#205c74"
    },
    "method": {
      "foreground": "#7c410e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7c410e"
    },
    "namespace": {
      "foreground": "#345652"
    },
    "number": {
      "foreground": "#3b3b3a"
    },
    "operator": {
      "foreground": "#ac1318"
    },
    "parameter": {
      "foreground": "#384b68"
    },
    "property": {
      "foreground": "#2f5e57"
    },
    "property.declaration": {
      "foreground": "#384b68"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#125895"
    },
    "string": {
      "foreground": "#235a3d"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2b611d"
    },
    "string.regexp": {
      "foreground": "#2b611d"
    },
    "struct": {
      "foreground": "#345652"
    },
    "type": {
      "foreground": "#345652"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#345652"
    },
    "variable": {
      "foreground": "#384b68"
    },
    "variable.defaultLibrary": {
      "foreground": "#565654"
    },
    "variable.readonly": {
      "foreground": "#3b3b3a"
    },
    "variable.readonly.local": {
      "foreground": "#384b68"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4c6a7e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#125895"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#235a3d"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2b611d"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b611d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7c410e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#345652"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3b3b3a"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#384b68"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#565654"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#345652"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#84450e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7c410e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#045690"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#11528c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#a1272d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#87817c"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2f5e57"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#125895"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#87817c"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3b3b3a"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#345652"
      }
    }
  ],
  "type": "light"
}