  "name": "Oasis Cactus Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#40403f"
    },
    "class": {
      "foreground": "#165891"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5a715d"
    },
    "decorator": {
      "foreground": "#8b490f"
    },
