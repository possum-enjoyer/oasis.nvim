      "fontStyle": "italic",
      "foreground": "#5a715d"
    },
    "enum": {
      "foreground": "#165891"
    },
    "enumMember": {
      "foreground": "#40403f"
    },
    "function": {
      "foreground": "#83450e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#83450e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#90867e"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#165891"
    },
    "keyword": {
      "foreground": "#3a643d"
    },
    "label": {
      "foreground": "#3a643d"
    },
    "macro": {
      "foreground": "#80500e"
    },
    "method": {
      "foreground": "#83450e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#83450e"
    },
    "namespace": {
      "foreground": "#165891"
    },
    "number": {
      "foreground": "#40403f"
    },
    "operator": {
      "foreground": "#b51419"
    },
    "parameter": {
      "foreground": "#405348"
    },
    "property": {
      "foreground": "#25617b"
    },
    "property.declaration": {
      "foreground": "#405348"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#3a643d"
    },
    "string": {
      "foreground": "#256041"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2e671f"
    },
    "string.regexp": {
      "foreground": "#2e671f"
    },
    "struct": {
      "foreground": "#165891"
    },
    "type": {
      "foreground": "#165891"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#165891"
    },
    "variable": {
      "foreground": "#405348"
    },
    "variable.defaultLibrary": {
      "foreground": "#5a5a59"
    },
    "variable.readonly": {
      "foreground": "#40403f"
    },
    "variable.readonly.local": {
      "foreground": "#405348"
    }
