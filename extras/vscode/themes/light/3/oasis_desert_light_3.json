  "name": "Oasis Desert Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3e3e3d"
    },
    "class": {
      "foreground": "#2f5b54"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#596c7b"
    },
    "decorator": {
      "foreground": "#89480f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#596c7b"
    },
    "enum": {
      "foreground": "#2f5b54"
    },
    "enumMember": {
      "foreground": "#3e3e3d"
    },
    "function": {
      "foreground": "#754a0d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#754a0d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8e847c"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2f5b54"
    },
    "keyword": {
      "foreground": "#645918"
    },
    "label": {
      "foreground": "#645918"
    },
    "macro": {
      "foreground": "#216078"
    },
    "method": {
      "foreground": "#754a0d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#754a0d"
    },
    "namespace": {
      "foreground": "#2f5b54"
    },
    "number": {
      "foreground": "#3e3e3d"
    },
    "operator": {
      "foreground": "#983c19"
    },
    "parameter": {
      "foreground": "#5a4a38"
    },
    "property": {
      "foreground": "#31615a"
    },
    "property.declaration": {
      "foreground": "#5a4a38"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#645918"
    },
    "string": {
      "foreground": "#215f3d"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2d651d"
    },
    "string.regexp": {
      "foreground": "#2d651d"
    },
    "struct": {
      "foreground": "#2f5b54"
    },
    "type": {
      "foreground": "#2f5b54"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2f5b54"
    },
    "variable": {
      "foreground": "#5a4a38"
    },
    "variable.defaultLibrary": {
      "foreground": "#58595a"
    },
    "variable.readonly": {
      "foreground": "#3e3e3d"
    },
    "variable.readonly.local": {
      "foreground": "#5a4a38"
    }
