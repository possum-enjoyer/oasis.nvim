  "name": "Oasis Midnight Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3c3c3b"
    },
    "class": {
      "foreground": "#2f5954"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5d687a"
    },
    "decorator": {
      "foreground": "#85460f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#5d687a"
    },
    "enum": {
      "foreground": "#2f5954"
    },
    "enumMember": {
      "foreground": "#3c3c3b"
    },
    "function": {
      "foreground": "#7d420e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7d420e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#89827d"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2f5954"
    },
    "keyword": {
      "foreground": "#a52429"
    },
    "label": {
      "foreground": "#a52429"
    },
    "macro": {
      "foreground": "#205d75"
    },
    "method": {
      "foreground": "#7d420e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7d420e"
    },
    "namespace": {
      "foreground": "#2f5954"
    },
    "number": {
      "foreground": "#3c3c3b"
    },
    "operator": {
      "foreground": "#943b19"
    },
    "parameter": {
      "foreground": "#524943"
    },
    "property": {
      "foreground": "#315f58"
    },
    "property.declaration": {
      "foreground": "#524943"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#a52429"
    },
    "string": {
      "foreground": "#245b3e"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2c621e"
    },
    "string.regexp": {
      "foreground": "#2c621e"
    },
    "struct": {
      "foreground": "#2f5954"
    },
    "type": {
      "foreground": "#2f5954"
    },
    "type.declaration": {
      "foreground": "#2f5954"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2f5954"
    },
    "variable": {
      "foreground": "#524943"
    },
    "variable.defaultLibrary": {
      "foreground": "#565758"
    },
    "variable.readonly": {
      "foreground": "#3c3c3b"
    },
    "variable.readonly.local": {
      "foreground": "#524943"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5d687a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a52429"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#245b3e"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2c621e"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2c621e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7d420e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2f5954"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3c3c3b"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#524943"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#565758"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2f5954"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#85460f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7d420e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#702424"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a31217"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#a3282d"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#315f58"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#a52429"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#89827d"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3c3c3b"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2f5954"
      }
    }
  ],
  "type": "light"
}