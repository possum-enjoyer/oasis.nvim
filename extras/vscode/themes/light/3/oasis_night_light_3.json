  "name": "Oasis Night Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#353534"
    },
    "class": {
      "foreground": "#31514c"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#755b4c"
    },
    "decorator": {
      "foreground": "#7c410d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#755b4c"
    },
    "enum": {
      "foreground": "#31514c"
    },
    "enumMember": {
      "foreground": "#353534"
    },
    "function": {
      "foreground": "#6a420c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6a420c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7c7c7c"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#31514c"
    },
    "keyword": {
      "foreground": "#7c410d"
    },
    "label": {
      "foreground": "#7c410d"
    },
    "macro": {
      "foreground": "#1e566c"
    },
    "method": {
      "foreground": "#6a420c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6a420c"
    },
    "namespace": {
      "foreground": "#31514c"
    },
    "number": {
      "foreground": "#353534"
    },
    "operator": {
      "foreground": "#a11216"
    },
    "parameter": {
      "foreground": "#52412d"
    },
    "property": {
      "foreground": "#2e5751"
    },
    "property.declaration": {
      "foreground": "#52412d"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#7c410d"
    },
    "string": {
      "foreground": "#215439"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#295b1a"
    },
    "string.regexp": {
      "foreground": "#295b1a"
    },
    "struct": {
      "foreground": "#31514c"
    },
    "type": {
      "foreground": "#31514c"
    },
    "type.declaration": {
      "foreground": "#31514c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#31514c"
    },
    "variable": {
      "foreground": "#52412d"
    },
    "variable.defaultLibrary": {
      "foreground": "#4f5051"
    },
    "variable.readonly": {
      "foreground": "#353534"
    },
    "variable.readonly.local": {
      "foreground": "#52412d"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#755b4c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7c410d"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#215439"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#295b1a"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#295b1a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6a420c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#31514c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#353534"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#52412d"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4f5051"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#31514c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7c410d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6a420c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7d1717"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#733d0d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#97252a"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2e5751"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7c410d"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#353534"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#31514c"
      }
    }
  ],
  "type": "light"
}