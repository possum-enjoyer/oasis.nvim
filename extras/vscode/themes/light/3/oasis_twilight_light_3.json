  "name": "Oasis Twilight Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#393938"
    },
    "class": {
      "foreground": "#33544f"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#695f7b"
    },
    "decorator": {
      "foreground": "#80430e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#695f7b"
    },
    "enum": {
      "foreground": "#33544f"
    },
    "enumMember": {
      "foreground": "#393938"
    },
    "function": {
      "foreground": "#783f0d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#783f0d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#887e77"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#33544f"
    },
    "keyword": {
      "foreground": "#7416cd"
    },
    "label": {
      "foreground": "#7416cd"
    },
    "macro": {
      "foreground": "#1f5970"
    },
    "method": {
      "foreground": "#783f0d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#783f0d"
    },
    "namespace": {
      "foreground": "#33544f"
    },
    "number": {
      "foreground": "#393938"
    },
    "operator": {
      "foreground": "#a71217"
    },
    "parameter": {
      "foreground": "#4a4268"
    },
    "property": {
      "foreground": "#2e5b54"
    },
    "property.declaration": {
      "foreground": "#4a4268"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#7416cd"
    },
    "string": {
      "foreground": "#22583b"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2a5f1c"
    },
    "string.regexp": {
      "foreground": "#2a5f1c"
    },
    "struct": {
      "foreground": "#33544f"
    },
    "type": {
      "foreground": "#33544f"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#33544f"
    },
    "variable": {
      "foreground": "#4a4268"
    },
    "variable.defaultLibrary": {
      "foreground": "#525355"
    },
    "variable.readonly": {
      "foreground": "#393938"
    },
    "variable.readonly.local": {
      "foreground": "#4a4268"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#695f7b"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7416cd"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#22583b"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2a5f1c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2a5f1c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#783f0d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#33544f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#393938"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4a4268"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#525355"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#33544f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#80430e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#783f0d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#440391"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6d15c1"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#9c262b"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#887e77"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2e5b54"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7416cd"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#887e77"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#393938"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#33544f"
      }
    }
  ],
  "type": "light"
}