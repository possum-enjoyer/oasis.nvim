  "name": "Oasis Mirage Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#424241"
    },
    "class": {
      "foreground": "#175a94"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#47766e"
    },
    "decorator": {
      "foreground": "#8e4b10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#47766e"
    },
    "enum": {
      "foreground": "#175a94"
    },
    "enumMember": {
      "foreground": "#424241"
    },
    "function": {
      "foreground": "#86460f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#86460f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#928982"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#175a94"
    },
    "keyword": {
      "foreground": "#32655d"
    },
    "label": {
      "foreground": "#32655d"
    },
    "macro": {
      "foreground": "#85510f"
    },
    "method": {
      "foreground": "#86460f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#86460f"
    },
    "namespace": {
      "foreground": "#175a94"
    },
    "number": {
      "foreground": "#424241"
    },
    "operator": {
      "foreground": "#b9141a"
    },
    "parameter": {
      "foreground": "#405454"
    },
    "property": {
      "foreground": "#195fa1"
    },
    "property.declaration": {
      "foreground": "#405454"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#32655d"
    },
    "string": {
      "foreground": "#266243"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#30691f"
    },
    "string.regexp": {
      "foreground": "#30691f"
    },
    "struct": {
      "foreground": "#175a94"
    },
    "type": {
      "foreground": "#175a94"
    },
    "type.declaration": {
      "foreground": "#175a94"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#175a94"
    },
    "variable": {
      "foreground": "#405454"
    },
    "variable.defaultLibrary": {
      "foreground": "#5d5d5b"
    },
    "variable.readonly": {
      "foreground": "#424241"
    },
    "variable.readonly.local": {
      "foreground": "#405454"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#47766e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#32655d"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266243"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#30691f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#30691f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#86460f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#175a94"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#405454"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5d5d5b"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#175a94"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8e4b10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#86460f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2d6760"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#305f59"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#b61c22"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#195fa1"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#32655d"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#928982"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#424241"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#175a94"
      }
    }
  ],
  "type": "light"
}