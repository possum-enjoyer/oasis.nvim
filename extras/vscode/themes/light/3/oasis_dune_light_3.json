  "name": "Oasis Dune Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#424240"
    },
    "class": {
      "foreground": "#395d58"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#776b60"
    },
    "decorator": {
      "foreground": "#8e4a0f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#776b60"
    },
    "enum": {
      "foreground": "#395d58"
    },
    "enumMember": {
      "foreground": "#424240"
    },
    "function": {
      "foreground": "#85460f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#85460f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8a8a8a"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#395d58"
    },
    "keyword": {
      "foreground": "#685c19"
    },
    "label": {
      "foreground": "#685c19"
    },
    "macro": {
      "foreground": "#22637c"
    },
    "method": {
      "foreground": "#85460f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#85460f"
    },
    "namespace": {
      "foreground": "#395d58"
    },
    "number": {
      "foreground": "#424240"
    },
    "operator": {
      "foreground": "#b81419"
    },
    "parameter": {
      "foreground": "#525047"
    },
    "property": {
      "foreground": "#34655d"
    },
    "property.declaration": {
      "foreground": "#525047"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#685c19"
    },
    "string": {
      "foreground": "#266242"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2f691f"
    },
    "string.regexp": {
      "foreground": "#2f691f"
    },
    "struct": {
      "foreground": "#395d58"
    },
    "type": {
      "foreground": "#395d58"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#395d58"
    },
    "variable": {
      "foreground": "#525047"
    },
    "variable.defaultLibrary": {
      "foreground": "#5b5c5d"
    },
    "variable.readonly": {
      "foreground": "#424240"
    },
    "variable.readonly.local": {
      "foreground": "#525047"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#776b60"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#685c19"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#266242"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f691f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f691f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#85460f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#395d58"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#424240"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#525047"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5b5c5d"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#395d58"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8e4a0f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#85460f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#65612f"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#5c5831"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#b51c22"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#34655d"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#685c19"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#424240"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#395d58"
      }
    }
  ],
  "type": "light"
}