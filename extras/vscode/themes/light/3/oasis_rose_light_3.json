  "name": "Oasis Rose Light 3",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3b3b3a"
    },
    "class": {
      "foreground": "#2e5752"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#7c5e6c"
    },
    "decorator": {
      "foreground": "#84450e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#7c5e6c"
    },
    "enum": {
      "foreground": "#2e5752"
    },
    "enumMember": {
      "foreground": "#3b3b3a"
    },
    "function": {
      "foreground": "#7c410d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7c410d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8b8079"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2e5752"
    },
    "keyword": {
      "foreground": "#ab1318"
    },
    "label": {
      "foreground": "#ab1318"
    },
    "macro": {
      "foreground": "#1f5c73"
    },
    "method": {
      "foreground": "#7c410d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7c410d"
    },
    "namespace": {
      "foreground": "#2e5752"
    },
    "number": {
      "foreground": "#3b3b3a"
    },
    "operator": {
      "foreground": "#923a18"
    },
    "parameter": {
      "foreground": "#594353"
    },
    "property": {
      "foreground": "#305d56"
    },
    "property.declaration": {
      "foreground": "#594353"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#ab1318"
    },
    "string": {
      "foreground": "#235a3d"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2b611d"
    },
    "string.regexp": {
      "foreground": "#2b611d"
    },
    "struct": {
      "foreground": "#2e5752"
    },
    "type": {
      "foreground": "#2e5752"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2e5752"
    },
    "variable": {
      "foreground": "#594353"
    },
    "variable.defaultLibrary": {
      "foreground": "#545557"
    },
    "variable.readonly": {
      "foreground": "#3b3b3a"
    },
    "variable.readonly.local": {
      "foreground": "#594353"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7c5e6c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ab1318"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#235a3d"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2b611d"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b611d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7c410d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2e5752"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3b3b3a"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#594353"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#545557"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2e5752"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#84450e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7c410d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#910303"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a11216"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#a81a1f"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8b8079"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#305d56"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ab1318"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8b8079"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3b3b3a"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2e5752"
      }
    }
  ],
  "type": "light"
}