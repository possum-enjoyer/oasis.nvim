  "name": "Oasis Rose Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#484846"
    },
    "class": {
      "foreground": "#35655e"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#8b6a7a"
    },
    "decorator": {
      "foreground": "#984f11"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#8b6a7a"
    },
    "enum": {
      "foreground": "#35655e"
    },
    "enumMember": {
      "foreground": "#484846"
    },
    "function": {
      "foreground": "#8e4b10"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8e4b10"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#98908a"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#35655e"
    },
    "keyword": {
      "foreground": "#c3151c"
    },
    "label": {
      "foreground": "#c3151c"
    },
    "macro": {
      "foreground": "#246a86"
    },
    "method": {
      "foreground": "#8e4b10"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8e4b10"
    },
    "namespace": {
      "foreground": "#35655e"
    },
    "number": {
      "foreground": "#484846"
    },
    "operator": {
      "foreground": "#a8421c"
    },
    "parameter": {
      "foreground": "#694e63"
    },
    "property": {
      "foreground": "#386b63"
    },
    "property.declaration": {
      "foreground": "#694e63"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#c3151c"
    },
    "string": {
      "foreground": "#286947"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326f22"
    },
    "string.regexp": {
      "foreground": "#326f22"
    },
    "struct": {
      "foreground": "#35655e"
    },
    "type": {
      "foreground": "#35655e"
    },
    "type.declaration": {
      "foreground": "#35655e"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#35655e"
    },
    "variable": {
      "foreground": "#694e63"
    },
    "variable.defaultLibrary": {
      "foreground": "#616264"
    },
    "variable.readonly": {
      "foreground": "#484846"
    },
    "variable.readonly.local": {
      "foreground": "#694e63"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8b6a7a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c3151c"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286947"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326f22"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326f22"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8e4b10"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#35655e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#484846"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#694e63"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#616264"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#35655e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#984f11"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8e4b10"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#a20707"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b9141a"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#c01e23"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#98908a"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#386b63"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#c3151c"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#98908a"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#484846"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#35655e"
      }
    }
  ],
  "type": "light"
}