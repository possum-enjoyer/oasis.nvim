  "name": "Oasis Lagoon Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#484847"
    },
    "class": {
      "foreground": "#3c645e"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#577790"
    },
    "decorator": {
      "foreground": "#984f11"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#577790"
    },
    "enum": {
      "foreground": "#3c645e"
    },
    "enumMember": {
      "foreground": "#484847"
    },
    "function": {
      "foreground": "#8f4c10"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8f4c10"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#96908b"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#3c645e"
    },
    "keyword": {
      "foreground": "#1665aa"
    },
    "label": {
      "foreground": "#1665aa"
    },
    "macro": {
      "foreground": "#246a86"
    },
    "method": {
      "foreground": "#8f4c10"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8f4c10"
    },
    "namespace": {
      "foreground": "#3c645e"
    },
    "number": {
      "foreground": "#484847"
    },
    "operator": {
      "foreground": "#c4151c"
    },
    "parameter": {
      "foreground": "#40577a"
    },
    "property": {
      "foreground": "#376b63"
    },
    "property.declaration": {
      "foreground": "#40577a"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#1665aa"
    },
    "string": {
      "foreground": "#286947"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#337022"
    },
    "string.regexp": {
      "foreground": "#337022"
    },
    "struct": {
      "foreground": "#3c645e"
    },
    "type": {
      "foreground": "#3c645e"
    },
    "type.declaration": {
      "foreground": "#3c645e"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#3c645e"
    },
    "variable": {
      "foreground": "#40577a"
    },
    "variable.defaultLibrary": {
      "foreground": "#636361"
    },
    "variable.readonly": {
      "foreground": "#484847"
    },
    "variable.readonly.local": {
      "foreground": "#40577a"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#577790"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1665aa"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286947"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#337022"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#337022"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8f4c10"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3c645e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#484847"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#40577a"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#636361"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3c645e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#984f11"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8f4c10"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#0861a0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#135fa1"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#b82d32"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#96908b"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#376b63"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#1665aa"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#96908b"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#484847"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#3c645e"
      }
    }
  ],
  "type": "light"
}