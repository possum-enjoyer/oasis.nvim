  "name": "Oasis Midnight Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#464645"
    },
    "class": {
      "foreground": "#34635d"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#677286"
    },
    "decorator": {
      "foreground": "#954e10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#677286"
    },
    "enum": {
      "foreground": "#34635d"
    },
    "enumMember": {
      "foreground": "#464645"
    },
    "function": {
      "foreground": "#8c4a0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8c4a0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#948e89"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#34635d"
    },
    "keyword": {
      "foreground": "#b7292e"
    },
    "label": {
      "foreground": "#b7292e"
    },
    "macro": {
      "foreground": "#236883"
    },
    "method": {
      "foreground": "#8c4a0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8c4a0f"
    },
    "namespace": {
      "foreground": "#34635d"
    },
    "number": {
      "foreground": "#464645"
    },
    "operator": {
      "foreground": "#a5411b"
    },
    "parameter": {
      "foreground": "#5c534c"
    },
    "property": {
      "foreground": "#376961"
    },
    "property.declaration": {
      "foreground": "#5c534c"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#b7292e"
    },
    "string": {
      "foreground": "#276645"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326d21"
    },
    "string.regexp": {
      "foreground": "#326d21"
    },
    "struct": {
      "foreground": "#34635d"
    },
    "type": {
      "foreground": "#34635d"
    },
    "type.declaration": {
      "foreground": "#34635d"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#34635d"
    },
    "variable": {
      "foreground": "#5c534c"
    },
    "variable.defaultLibrary": {
      "foreground": "#5f6162"
    },
    "variable.readonly": {
      "foreground": "#464645"
    },
    "variable.readonly.local": {
      "foreground": "#5c534c"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#677286"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b7292e"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#276645"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326d21"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326d21"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#34635d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#464645"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#5c534c"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5f6162"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#34635d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#954e10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8c4a0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7d2b2b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b6141a"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#b52c31"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#376961"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b7292e"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#948e89"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#464645"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#34635d"
      }
    }
  ],
  "type": "light"
}