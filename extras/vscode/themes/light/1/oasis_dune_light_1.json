  "name": "Oasis Dune Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#474746"
    },
    "class": {
      "foreground": "#3b635d"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#7d7065"
    },
    "decorator": {
      "foreground": "#964e10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#7d7065"
    },
    "enum": {
      "foreground": "#3b635d"
    },
    "enumMember": {
      "foreground": "#474746"
    },
    "function": {
      "foreground": "#8d4b0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8d4b0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#909090"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#3b635d"
    },
    "keyword": {
      "foreground": "#6d6219"
    },
    "label": {
      "foreground": "#6d6219"
    },
    "macro": {
      "foreground": "#246985"
    },
    "method": {
      "foreground": "#8d4b0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8d4b0f"
    },
    "namespace": {
      "foreground": "#3b635d"
    },
    "number": {
      "foreground": "#474746"
    },
    "operator": {
      "foreground": "#c2151c"
    },
    "parameter": {
      "foreground": "#58554c"
    },
    "property": {
      "foreground": "#376a63"
    },
    "property.declaration": {
      "foreground": "#58554c"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#6d6219"
    },
    "string": {
      "foreground": "#276746"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326f21"
    },
    "string.regexp": {
      "foreground": "#326f21"
    },
    "struct": {
      "foreground": "#3b635d"
    },
    "type": {
      "foreground": "#3b635d"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#3b635d"
    },
    "variable": {
      "foreground": "#58554c"
    },
    "variable.defaultLibrary": {
      "foreground": "#606263"
    },
    "variable.readonly": {
      "foreground": "#474746"
    },
    "variable.readonly.local": {
      "foreground": "#58554c"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7d7065"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6d6219"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#276746"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326f21"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326f21"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8d4b0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3b635d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#474746"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#58554c"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#606263"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3b635d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#964e10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8d4b0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#726d36"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#625d34"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#be1e23"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#909090"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#376a63"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6d6219"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#909090"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#474746"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#3b635d"
      }
    }
  ],
  "type": "light"
}