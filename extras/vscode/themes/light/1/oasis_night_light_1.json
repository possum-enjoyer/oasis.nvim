  "name": "Oasis Night Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#353535"
    },
    "class": {
      "foreground": "#30514c"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#755b4c"
    },
    "decorator": {
      "foreground": "#7c410e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#755b4c"
    },
    "enum": {
      "foreground": "#30514c"
    },
    "enumMember": {
      "foreground": "#353535"
    },
    "function": {
      "foreground": "#6a430c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6a430c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7d7d7d"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#30514c"
    },
    "keyword": {
      "foreground": "#7b410d"
    },
    "label": {
      "foreground": "#7b410d"
    },
    "macro": {
      "foreground": "#1d566d"
    },
    "method": {
      "foreground": "#6a430c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6a430c"
    },
    "namespace": {
      "foreground": "#30514c"
    },
    "number": {
      "foreground": "#353535"
    },
    "operator": {
      "foreground": "#a11217"
    },
    "parameter": {
      "foreground": "#52422d"
    },
    "property": {
      "foreground": "#2e5852"
    },
    "property.declaration": {
      "foreground": "#52422d"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#7b410d"
    },
    "string": {
      "foreground": "#205439"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#295b1b"
    },
    "string.regexp": {
      "foreground": "#295b1b"
    },
    "struct": {
      "foreground": "#30514c"
    },
    "type": {
      "foreground": "#30514c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#30514c"
    },
    "variable": {
      "foreground": "#52422d"
    },
    "variable.defaultLibrary": {
      "foreground": "#4f5051"
    },
    "variable.readonly": {
      "foreground": "#353535"
    },
    "variable.readonly.local": {
      "foreground": "#52422d"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#755b4c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7b410d"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#205439"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#295b1b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#295b1b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6a430c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#30514c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#353535"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#52422d"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4f5051"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#30514c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7c410e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6a430c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c1c1c"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#743d0d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#972529"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7d7d7d"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2e5852"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7b410d"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7d7d7d"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#353535"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#30514c"
      }
    }
  ],
  "type": "light"
}