  "name": "Oasis Starlight Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#464645"
    },
    "class": {
      "foreground": "#3b635d"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#567499"
    },
    "decorator": {
      "foreground": "#964e10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#567499"
    },
    "enum": {
      "foreground": "#3b635d"
    },
    "enumMember": {
      "foreground": "#464645"
    },
    "function": {
      "foreground": "#8d4a0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8d4a0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#9b8d86"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#3b635d"
    },
    "keyword": {
      "foreground": "#1563a7"
    },
    "label": {
      "foreground": "#1563a7"
    },
    "macro": {
      "foreground": "#236884"
    },
    "method": {
      "foreground": "#8d4a0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8d4a0f"
    },
    "namespace": {
      "foreground": "#3b635d"
    },
    "number": {
      "foreground": "#464645"
    },
    "operator": {
      "foreground": "#c1151c"
    },
    "parameter": {
      "foreground": "#5c5442"
    },
    "property": {
      "foreground": "#366a62"
    },
    "property.declaration": {
      "foreground": "#5c5442"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#1563a7"
    },
    "string": {
      "foreground": "#276746"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326e21"
    },
    "string.regexp": {
      "foreground": "#326e21"
    },
    "struct": {
      "foreground": "#3b635d"
    },
    "type": {
      "foreground": "#3b635d"
    },
    "type.declaration": {
      "foreground": "#3b635d"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#3b635d"
    },
    "variable": {
      "foreground": "#5c5442"
    },
    "variable.defaultLibrary": {
      "foreground": "#616160"
    },
    "variable.readonly": {
      "foreground": "#464645"
    },
    "variable.readonly.local": {
      "foreground": "#5c5442"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#567499"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1563a7"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#276746"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326e21"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326e21"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8d4a0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3b635d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#464645"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#5c5442"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#616160"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3b635d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#964e10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8d4a0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#0961a0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#135e9e"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#c1151c"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#366a62"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#1563a7"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#9b8d86"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#464645"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#3b635d"
      }
    }
  ],
  "type": "light"
}