  "name": "Oasis Mirage Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#484847"
    },
    "class": {
      "foreground": "#19609f"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#4a7d76"
    },
    "decorator": {
      "foreground": "#995011"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#4a7d76"
    },
    "enum": {
      "foreground": "#19609f"
    },
    "enumMember": {
      "foreground": "#484847"
    },
    "function": {
      "foreground": "#8f4c10"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8f4c10"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#99908a"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#19609f"
    },
    "keyword": {
      "foreground": "#356c63"
    },
    "label": {
      "foreground": "#356c63"
    },
    "macro": {
      "foreground": "#8d560f"
    },
    "method": {
      "foreground": "#8f4c10"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8f4c10"
    },
    "namespace": {
      "foreground": "#19609f"
    },
    "number": {
      "foreground": "#484847"
    },
    "operator": {
      "foreground": "#c4151c"
    },
    "parameter": {
      "foreground": "#455b5b"
    },
    "property": {
      "foreground": "#1a65aa"
    },
    "property.declaration": {
      "foreground": "#455b5b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#356c63"
    },
    "string": {
      "foreground": "#286947"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#337022"
    },
    "string.regexp": {
      "foreground": "#337022"
    },
    "struct": {
      "foreground": "#19609f"
    },
    "type": {
      "foreground": "#19609f"
    },
    "type.declaration": {
      "foreground": "#19609f"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#19609f"
    },
    "variable": {
      "foreground": "#455b5b"
    },
    "variable.defaultLibrary": {
      "foreground": "#636361"
    },
    "variable.readonly": {
      "foreground": "#484847"
    },
    "variable.readonly.local": {
      "foreground": "#455b5b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4a7d76"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#356c63"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286947"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#337022"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#337022"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8f4c10"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#19609f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#484847"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#455b5b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#636361"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#19609f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#995011"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8f4c10"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#34746c"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#346660"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#c11e23"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#99908a"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#1a65aa"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#356c63"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#99908a"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#484847"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#19609f"
      }
    }
  ],
  "type": "light"
}