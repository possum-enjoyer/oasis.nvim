  "name": "Oasis Sol Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#464644"
    },
    "class": {
      "foreground": "#34635c"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#846c68"
    },
    "decorator": {
      "foreground": "#944d10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#846c68"
    },
    "enum": {
      "foreground": "#34635c"
    },
    "enumMember": {
      "foreground": "#464644"
    },
    "function": {
      "foreground": "#8b4a0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8b4a0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8f8f8f"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#34635c"
    },
    "keyword": {
      "foreground": "#b6282c"
    },
    "label": {
      "foreground": "#b6282c"
    },
    "macro": {
      "foreground": "#236783"
    },
    "method": {
      "foreground": "#8b4a0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8b4a0f"
    },
    "namespace": {
      "foreground": "#34635c"
    },
    "number": {
      "foreground": "#464644"
    },
    "operator": {
      "foreground": "#a4411b"
    },
    "parameter": {
      "foreground": "#814236"
    },
    "property": {
      "foreground": "#376961"
    },
    "property.declaration": {
      "foreground": "#814236"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#b6282c"
    },
    "string": {
      "foreground": "#276645"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#316d21"
    },
    "string.regexp": {
      "foreground": "#316d21"
    },
    "struct": {
      "foreground": "#34635c"
    },
    "type": {
      "foreground": "#34635c"
    },
    "type.declaration": {
      "foreground": "#34635c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#34635c"
    },
    "variable": {
      "foreground": "#814236"
    },
    "variable.defaultLibrary": {
      "foreground": "#5f6062"
    },
    "variable.readonly": {
      "foreground": "#464644"
    },
    "variable.readonly.local": {
      "foreground": "#814236"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#846c68"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b6282c"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#276645"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#316d21"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#316d21"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8b4a0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#34635c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#464644"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#814236"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5f6062"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#34635c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#944d10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8b4a0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c1c1c"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#b5141a"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ac381d"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#376961"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b6282c"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8f8f8f"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#464644"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#34635c"
      }
    }
  ],
  "type": "light"
}