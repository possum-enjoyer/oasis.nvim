  "name": "Oasis Twilight Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#474746"
    },
    "class": {
      "foreground": "#3c645e"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#796e90"
    },
    "decorator": {
      "foreground": "#974f11"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#796e90"
    },
    "enum": {
      "foreground": "#3c645e"
    },
    "enumMember": {
      "foreground": "#474746"
    },
    "function": {
      "foreground": "#8e4b0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8e4b0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#988f89"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#3c645e"
    },
    "keyword": {
      "foreground": "#8724e7"
    },
    "label": {
      "foreground": "#8724e7"
    },
    "macro": {
      "foreground": "#246985"
    },
    "method": {
      "foreground": "#8e4b0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8e4b0f"
    },
    "namespace": {
      "foreground": "#3c645e"
    },
    "number": {
      "foreground": "#474746"
    },
    "operator": {
      "foreground": "#c3151c"
    },
    "parameter": {
      "foreground": "#5b4f7e"
    },
    "property": {
      "foreground": "#366b63"
    },
    "property.declaration": {
      "foreground": "#5b4f7e"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#8724e7"
    },
    "string": {
      "foreground": "#286847"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326f22"
    },
    "string.regexp": {
      "foreground": "#326f22"
    },
    "struct": {
      "foreground": "#3c645e"
    },
    "type": {
      "foreground": "#3c645e"
    },
    "type.declaration": {
      "foreground": "#3c645e"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#3c645e"
    },
    "variable": {
      "foreground": "#5b4f7e"
    },
    "variable.defaultLibrary": {
      "foreground": "#616263"
    },
    "variable.readonly": {
      "foreground": "#474746"
    },
    "variable.readonly.local": {
      "foreground": "#5b4f7e"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#796e90"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8724e7"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#286847"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326f22"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326f22"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8e4b0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#3c645e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#474746"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#5b4f7e"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#616263"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#3c645e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#974f11"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8e4b0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4e07a2"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8119e2"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#b72d32"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#366b63"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#8724e7"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#988f89"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#474746"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#3c645e"
      }
    }
  ],
  "type": "light"
}