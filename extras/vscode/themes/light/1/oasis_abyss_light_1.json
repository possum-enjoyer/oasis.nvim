  "name": "Oasis Abyss Light 1",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#464645"
    },
    "class": {
      "foreground": "#34645d"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#63757e"
    },
    "decorator": {
      "foreground": "#964e10"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#63757e"
    },
    "enum": {
      "foreground": "#34645d"
    },
    "enumMember": {
      "foreground": "#464645"
    },
    "function": {
      "foreground": "#8d4a0f"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#8d4a0f"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#978e88"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#34645d"
    },
    "keyword": {
      "foreground": "#bb2328"
    },
    "label": {
      "foreground": "#bb2328"
    },
    "macro": {
      "foreground": "#2a6786"
    },
    "method": {
      "foreground": "#8d4a0f"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#8d4a0f"
    },
    "namespace": {
      "foreground": "#34645d"
    },
    "number": {
      "foreground": "#464645"
    },
    "operator": {
      "foreground": "#a93d1c"
    },
    "parameter": {
      "foreground": "#5c534b"
    },
    "property": {
      "foreground": "#3e6862"
    },
    "property.declaration": {
      "foreground": "#5c534b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#bb2328"
    },
    "string": {
      "foreground": "#276746"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#326e21"
    },
    "string.regexp": {
      "foreground": "#326e21"
    },
    "struct": {
      "foreground": "#34645d"
    },
    "type": {
      "foreground": "#34645d"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#34645d"
    },
    "variable": {
      "foreground": "#5c534b"
    },
    "variable.defaultLibrary": {
      "foreground": "#606162"
    },
    "variable.readonly": {
      "foreground": "#464645"
    },
    "variable.readonly.local": {
      "foreground": "#5c534b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#63757e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#bb2328"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#276746"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#326e21"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#326e21"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8d4a0f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#34645d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#464645"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#5c534b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#606162"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#34645d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#964e10"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8d4a0f"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7d2b2b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a92e32"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#ad373a"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#978e88"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3e6862"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#bb2328"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#978e88"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#464645"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#34645d"
      }
    }
  ],
  "type": "light"
}