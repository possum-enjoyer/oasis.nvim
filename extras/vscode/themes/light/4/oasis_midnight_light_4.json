  "name": "Oasis Midnight Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#383737"
    },
    "class": {
      "foreground": "#2c534e"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#596375"
    },
    "decorator": {
      "foreground": "#7e420e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#596375"
    },
    "enum": {
      "foreground": "#2c534e"
    },
    "enumMember": {
      "foreground": "#383737"
    },
    "function": {
      "foreground": "#753e0d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#753e0d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#847d77"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2c534e"
    },
    "keyword": {
      "foreground": "#9b2427"
    },
    "label": {
      "foreground": "#9b2427"
    },
    "macro": {
      "foreground": "#1f586f"
    },
    "method": {
      "foreground": "#753e0d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#753e0d"
    },
    "namespace": {
      "foreground": "#2c534e"
    },
    "number": {
      "foreground": "#383737"
    },
    "operator": {
      "foreground": "#8d3616"
    },
    "parameter": {
      "foreground": "#4d443e"
    },
    "property": {
      "foreground": "#2f5953"
    },
    "property.declaration": {
      "foreground": "#4d443e"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#9b2427"
    },
    "string": {
      "foreground": "#21563a"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2a5d1c"
    },
    "string.regexp": {
      "foreground": "#2a5d1c"
    },
    "struct": {
      "foreground": "#2c534e"
    },
    "type": {
      "foreground": "#2c534e"
    },
    "type.declaration": {
      "foreground": "#2c534e"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2c534e"
    },
    "variable": {
      "foreground": "#4d443e"
    },
    "variable.defaultLibrary": {
      "foreground": "#515252"
    },
    "variable.readonly": {
      "foreground": "#383737"
    },
    "variable.readonly.local": {
      "foreground": "#4d443e"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#596375"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9b2427"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#21563a"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2a5d1c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2a5d1c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#753e0d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2c534e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#383737"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4d443e"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#515252"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2c534e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7e420e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#753e0d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#692121"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#9a1116"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#9a2629"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#847d77"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2f5953"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9b2427"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#847d77"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#383737"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2c534e"
      }
    }
  ],
  "type": "light"
}