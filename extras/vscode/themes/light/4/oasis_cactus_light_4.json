  "name": "Oasis Cactus Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3f3e3e"
    },
    "class": {
      "foreground": "#16568f"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#5a6f5c"
    },
    "decorator": {
      "foreground": "#89480f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#5a6f5c"
    },
    "enum": {
      "foreground": "#16568f"
    },
    "enumMember": {
      "foreground": "#3f3e3e"
    },
    "function": {
      "foreground": "#80440e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#80440e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8f847d"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#16568f"
    },
    "keyword": {
      "foreground": "#3a623c"
    },
    "label": {
      "foreground": "#3a623c"
    },
    "macro": {
      "foreground": "#7d4f0e"
    },
    "method": {
      "foreground": "#80440e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#80440e"
    },
    "namespace": {
      "foreground": "#16568f"
    },
    "number": {
      "foreground": "#3f3e3e"
    },
    "operator": {
      "foreground": "#b21319"
    },
    "parameter": {
      "foreground": "#405147"
    },
    "property": {
      "foreground": "#256078"
    },
    "property.declaration": {
      "foreground": "#405147"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#3a623c"
    },
    "string": {
      "foreground": "#245e40"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2e651f"
    },
    "string.regexp": {
      "foreground": "#2e651f"
    },
    "struct": {
      "foreground": "#16568f"
    },
    "type": {
      "foreground": "#16568f"
    },
    "type.declaration": {
      "foreground": "#16568f"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#16568f"
    },
    "variable": {
      "foreground": "#405147"
    },
    "variable.defaultLibrary": {
      "foreground": "#595957"
    },
    "variable.readonly": {
      "foreground": "#3f3e3e"
    },
    "variable.readonly.local": {
      "foreground": "#405147"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5a6f5c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3a623c"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#245e40"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2e651f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e651f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#80440e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#16568f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3f3e3e"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#405147"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#595957"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#16568f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#89480f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#80440e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#305a32"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#375c38"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#af1c20"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8f847d"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#256078"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#3a623c"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8f847d"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3f3e3e"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#16568f"
      }
    }
  ],
  "type": "light"
}