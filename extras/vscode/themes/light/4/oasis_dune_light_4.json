  "name": "Oasis Dune Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3f3e3e"
    },
    "class": {
      "foreground": "#365a54"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#73685c"
    },
    "decorator": {
      "foreground": "#89470f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#73685c"
    },
    "enum": {
      "foreground": "#365a54"
    },
    "enumMember": {
      "foreground": "#3f3e3e"
    },
    "function": {
      "foreground": "#80430e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#80430e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#868686"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#365a54"
    },
    "keyword": {
      "foreground": "#635918"
    },
    "label": {
      "foreground": "#635918"
    },
    "macro": {
      "foreground": "#215f79"
    },
    "method": {
      "foreground": "#80430e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#80430e"
    },
    "namespace": {
      "foreground": "#365a54"
    },
    "number": {
      "foreground": "#3f3e3e"
    },
    "operator": {
      "foreground": "#b11319"
    },
    "parameter": {
      "foreground": "#4f4d44"
    },
    "property": {
      "foreground": "#32615a"
    },
    "property.declaration": {
      "foreground": "#4f4d44"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#635918"
    },
    "string": {
      "foreground": "#245e40"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2d641f"
    },
    "string.regexp": {
      "foreground": "#2d641f"
    },
    "struct": {
      "foreground": "#365a54"
    },
    "type": {
      "foreground": "#365a54"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#365a54"
    },
    "variable": {
      "foreground": "#4f4d44"
    },
    "variable.defaultLibrary": {
      "foreground": "#575959"
    },
    "variable.readonly": {
      "foreground": "#3f3e3e"
    },
    "variable.readonly.local": {
      "foreground": "#4f4d44"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#73685c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#635918"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#245e40"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2d641f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2d641f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#80430e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#365a54"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3f3e3e"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4f4d44"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#575959"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#365a54"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#89470f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#80430e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5f5b2b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#59542f"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#ae1c20"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#868686"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#32615a"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#635918"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#868686"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3f3e3e"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#365a54"
      }
    }
  ],
  "type": "light"
}