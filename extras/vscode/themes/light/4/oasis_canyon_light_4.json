  "name": "Oasis Canyon Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3a3a39"
    },
    "class": {
      "foreground": "#335550"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#7b604f"
    },
    "decorator": {
      "foreground": "#83440e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#7b604f"
    },
    "enum": {
      "foreground": "#335550"
    },
    "enumMember": {
      "foreground": "#3a3a39"
    },
    "function": {
      "foreground": "#70470c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#70470c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#818181"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#335550"
    },
    "keyword": {
      "foreground": "#82450e"
    },
    "label": {
      "foreground": "#82450e"
    },
    "macro": {
      "foreground": "#205b73"
    },
    "method": {
      "foreground": "#70470c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#70470c"
    },
    "namespace": {
      "foreground": "#335550"
    },
    "number": {
      "foreground": "#3a3a39"
    },
    "operator": {
      "foreground": "#aa1218"
    },
    "parameter": {
      "foreground": "#574630"
    },
    "property": {
      "foreground": "#305c56"
    },
    "property.declaration": {
      "foreground": "#574630"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#82450e"
    },
    "string": {
      "foreground": "#235a3d"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2a601c"
    },
    "string.regexp": {
      "foreground": "#2a601c"
    },
    "struct": {
      "foreground": "#335550"
    },
    "type": {
      "foreground": "#335550"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#335550"
    },
    "variable": {
      "foreground": "#574630"
    },
    "variable.defaultLibrary": {
      "foreground": "#545555"
    },
    "variable.readonly": {
      "foreground": "#3a3a39"
    },
    "variable.readonly.local": {
      "foreground": "#574630"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7b604f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#82450e"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#235a3d"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2a601c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2a601c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#70470c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#335550"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3a3a39"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#574630"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#545555"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#335550"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#83440e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#70470c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#884401"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7b400d"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#9f272b"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#818181"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#305c56"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#82450e"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#818181"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3a3a39"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#335550"
      }
    }
  ],
  "type": "light"
}