  "name": "Oasis Abyss Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3a3939"
    },
    "class": {
      "foreground": "#2d5550"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#58676f"
    },
    "decorator": {
      "foreground": "#81440e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#58676f"
    },
    "enum": {
      "foreground": "#2d5550"
    },
    "enumMember": {
      "foreground": "#3a3939"
    },
    "function": {
      "foreground": "#78400d"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#78400d"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#887f78"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2d5550"
    },
    "keyword": {
      "foreground": "#a22024"
    },
    "label": {
      "foreground": "#a22024"
    },
    "macro": {
      "foreground": "#245974"
    },
    "method": {
      "foreground": "#78400d"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#78400d"
    },
    "namespace": {
      "foreground": "#2d5550"
    },
    "number": {
      "foreground": "#3a3939"
    },
    "operator": {
      "foreground": "#943418"
    },
    "parameter": {
      "foreground": "#4e473f"
    },
    "property": {
      "foreground": "#365a55"
    },
    "property.declaration": {
      "foreground": "#4e473f"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#a22024"
    },
    "string": {
      "foreground": "#22583c"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2b5f1d"
    },
    "string.regexp": {
      "foreground": "#2b5f1d"
    },
    "struct": {
      "foreground": "#2d5550"
    },
    "type": {
      "foreground": "#2d5550"
    },
    "type.declaration": {
      "foreground": "#2d5550"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2d5550"
    },
    "variable": {
      "foreground": "#4e473f"
    },
    "variable.defaultLibrary": {
      "foreground": "#535454"
    },
    "variable.readonly": {
      "foreground": "#3a3939"
    },
    "variable.readonly.local": {
      "foreground": "#4e473f"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#58676f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a22024"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#22583c"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2b5f1d"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2b5f1d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#78400d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2d5550"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3a3939"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4e473f"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#535454"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2d5550"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#81440e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#78400d"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#692121"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#91282c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#972f32"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#365a55"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#a22024"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#887f78"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3a3939"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2d5550"
      }
    }
  ],
  "type": "light"
}