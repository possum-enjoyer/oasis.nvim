      "foreground": "#817b75"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#30514c"
    },
    "keyword": {
      "foreground": "#11528a"
    },
    "label": {
      "foreground": "#11528a"
    },
    "macro": {
      "foreground": "#1e566d"
    },
    "method": {
      "foreground": "#733c0d"
