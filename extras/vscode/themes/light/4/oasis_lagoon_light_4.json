      "fontStyle": "bold",
      "foreground": "#733c0d"
    },
    "namespace": {
      "foreground": "#30514c"
    },
    "number": {
      "foreground": "#363535"
    },
    "operator": {
      "foreground": "#a01117"
    },
    "parameter": {
      "foreground": "#334561"
    },
    "property": {
      "foreground": "#2c5751"
    },
    "property.declaration": {
      "foreground": "#334561"
