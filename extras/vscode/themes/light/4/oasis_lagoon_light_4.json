    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#11528a"
    },
    "string": {
      "foreground": "#205439"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#295b1c"
    },
    "string.regexp": {
      "foreground": "#295b1c"
    },
    "struct": {
