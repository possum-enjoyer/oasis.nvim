  "name": "Oasis Night Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#333332"
    },
    "class": {
      "foreground": "#2f4e49"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#72594a"
    },
    "decorator": {
      "foreground": "#783f0d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#72594a"
    },
    "enum": {
      "foreground": "#2f4e49"
    },
    "enumMember": {
      "foreground": "#333332"
    },
    "function": {
      "foreground": "#66400b"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#66400b"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7a7a7a"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2f4e49"
    },
    "keyword": {
      "foreground": "#773f0d"
    },
    "label": {
      "foreground": "#773f0d"
    },
    "macro": {
      "foreground": "#1d536a"
    },
    "method": {
      "foreground": "#66400b"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#66400b"
    },
    "namespace": {
      "foreground": "#2f4e49"
    },
    "number": {
      "foreground": "#333332"
    },
    "operator": {
      "foreground": "#9c1116"
    },
    "parameter": {
      "foreground": "#4f3f2b"
    },
    "property": {
      "foreground": "#2c554f"
    },
    "property.declaration": {
      "foreground": "#4f3f2b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#773f0d"
    },
    "string": {
      "foreground": "#1f5237"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#27591a"
    },
    "string.regexp": {
      "foreground": "#27591a"
    },
    "struct": {
      "foreground": "#2f4e49"
    },
    "type": {
      "foreground": "#2f4e49"
    },
    "type.declaration": {
      "foreground": "#2f4e49"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2f4e49"
    },
    "variable": {
      "foreground": "#4f3f2b"
    },
    "variable.defaultLibrary": {
      "foreground": "#4d4e4e"
    },
    "variable.readonly": {
      "foreground": "#333332"
    },
    "variable.readonly.local": {
      "foreground": "#4f3f2b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#72594a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#773f0d"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1f5237"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#27591a"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#27591a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#66400b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2f4e49"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#333332"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#4f3f2b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4d4e4e"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2f4e49"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#783f0d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#66400b"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#751414"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#703b0c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#932427"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2c554f"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#773f0d"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7a7a7a"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#333332"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2f4e49"
      }
    }
  ],
  "type": "light"
}