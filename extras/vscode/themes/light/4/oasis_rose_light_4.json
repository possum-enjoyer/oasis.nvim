  "name": "Oasis Rose Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#353434"
    },
    "class": {
      "foreground": "#2a504c"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#745766"
    },
    "decorator": {
      "foreground": "#7a400d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#745766"
    },
    "enum": {
      "foreground": "#2a504c"
    },
    "enumMember": {
      "foreground": "#353434"
    },
    "function": {
      "foreground": "#713c0c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#713c0c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#827973"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2a504c"
    },
    "keyword": {
      "foreground": "#9f1116"
    },
    "label": {
      "foreground": "#9f1116"
    },
    "macro": {
      "foreground": "#1e556b"
    },
    "method": {
      "foreground": "#713c0c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#713c0c"
    },
    "namespace": {
      "foreground": "#2a504c"
    },
    "number": {
      "foreground": "#353434"
    },
    "operator": {
      "foreground": "#883416"
    },
    "parameter": {
      "foreground": "#513d4b"
    },
    "property": {
      "foreground": "#2d5650"
    },
    "property.declaration": {
      "foreground": "#513d4b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#9f1116"
    },
    "string": {
      "foreground": "#205338"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#28591b"
    },
    "string.regexp": {
      "foreground": "#28591b"
    },
    "struct": {
      "foreground": "#2a504c"
    },
    "type": {
      "foreground": "#2a504c"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2a504c"
    },
    "variable": {
      "foreground": "#513d4b"
    },
    "variable.defaultLibrary": {
      "foreground": "#4e4f4f"
    },
    "variable.readonly": {
      "foreground": "#353434"
    },
    "variable.readonly.local": {
      "foreground": "#513d4b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#745766"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9f1116"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#205338"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#28591b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#28591b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#713c0c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2a504c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#353434"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#513d4b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4e4f4f"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2a504c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7a400d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#713c0c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#880101"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#941015"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#9c191c"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#827973"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2d5650"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9f1116"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#827973"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#353434"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2a504c"
      }
    }
  ],
  "type": "light"
}