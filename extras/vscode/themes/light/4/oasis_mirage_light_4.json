  "name": "Oasis Mirage Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#414040"
    },
    "class": {
      "foreground": "#175892"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#45746d"
    },
    "decorator": {
      "foreground": "#8c490f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#45746d"
    },
    "enum": {
      "foreground": "#175892"
    },
    "enumMember": {
      "foreground": "#414040"
    },
    "function": {
      "foreground": "#83460e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#83460e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8f8780"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#175892"
    },
    "keyword": {
      "foreground": "#31635c"
    },
    "label": {
      "foreground": "#31635c"
    },
    "macro": {
      "foreground": "#824f0e"
    },
    "method": {
      "foreground": "#83460e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#83460e"
    },
    "namespace": {
      "foreground": "#175892"
    },
    "number": {
      "foreground": "#414040"
    },
    "operator": {
      "foreground": "#b5141a"
    },
    "parameter": {
      "foreground": "#3e5252"
    },
    "property": {
      "foreground": "#175d9d"
    },
    "property.declaration": {
      "foreground": "#3e5252"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#31635c"
    },
    "string": {
      "foreground": "#256041"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2e671f"
    },
    "string.regexp": {
      "foreground": "#2e671f"
    },
    "struct": {
      "foreground": "#175892"
    },
    "type": {
      "foreground": "#175892"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#175892"
    },
    "variable": {
      "foreground": "#3e5252"
    },
    "variable.defaultLibrary": {
      "foreground": "#5b5b59"
    },
    "variable.readonly": {
      "foreground": "#414040"
    },
    "variable.readonly.local": {
      "foreground": "#3e5252"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#45746d"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#31635c"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#256041"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2e671f"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2e671f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#83460e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#175892"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#414040"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#3e5252"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#5b5b59"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#175892"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8c490f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#83460e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#29615a"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2f5d58"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#b21c20"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8f8780"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#175d9d"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#31635c"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8f8780"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#414040"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#175892"
      }
    }
  ],
  "type": "light"
}