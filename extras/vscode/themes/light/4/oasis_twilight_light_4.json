  "name": "Oasis Twilight Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#313030"
    },
    "class": {
      "foreground": "#2d4c47"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#605770"
    },
    "decorator": {
      "foreground": "#743d0d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#605770"
    },
    "enum": {
      "foreground": "#2d4c47"
    },
    "enumMember": {
      "foreground": "#313030"
    },
    "function": {
      "foreground": "#6c380c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6c380c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#7e756f"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2d4c47"
    },
    "keyword": {
      "foreground": "#6914ba"
    },
    "label": {
      "foreground": "#6914ba"
    },
    "macro": {
      "foreground": "#1c5167"
    },
    "method": {
      "foreground": "#6c380c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6c380c"
    },
    "namespace": {
      "foreground": "#2d4c47"
    },
    "number": {
      "foreground": "#313030"
    },
    "operator": {
      "foreground": "#971015"
    },
    "parameter": {
      "foreground": "#433a5c"
    },
    "property": {
      "foreground": "#2a524c"
    },
    "property.declaration": {
      "foreground": "#433a5c"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#6914ba"
    },
    "string": {
      "foreground": "#1e4f35"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#27561a"
    },
    "string.regexp": {
      "foreground": "#27561a"
    },
    "struct": {
      "foreground": "#2d4c47"
    },
    "type": {
      "foreground": "#2d4c47"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2d4c47"
    },
    "variable": {
      "foreground": "#433a5c"
    },
    "variable.defaultLibrary": {
      "foreground": "#4a4c4c"
    },
    "variable.readonly": {
      "foreground": "#313030"
    },
    "variable.readonly.local": {
      "foreground": "#433a5c"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#605770"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6914ba"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1e4f35"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#27561a"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#27561a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6c380c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2d4c47"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#313030"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#433a5c"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4a4c4c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2d4c47"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#743d0d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6c380c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#3f0188"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6213ae"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#8e2326"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7e756f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2a524c"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#6914ba"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#7e756f"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#313030"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2d4c47"
      }
    }
  ],
  "type": "light"
}