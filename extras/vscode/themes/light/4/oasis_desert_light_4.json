  "name": "Oasis Desert Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3b3a3a"
    },
    "class": {
      "foreground": "#2e5650"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#556776"
    },
    "decorator": {
      "foreground": "#82450e"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#556776"
    },
    "enum": {
      "foreground": "#2e5650"
    },
    "enumMember": {
      "foreground": "#3b3a3a"
    },
    "function": {
      "foreground": "#70470c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#70470c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#8a8078"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#2e5650"
    },
    "keyword": {
      "foreground": "#5e5517"
    },
    "label": {
      "foreground": "#5e5517"
    },
    "macro": {
      "foreground": "#205b73"
    },
    "method": {
      "foreground": "#70470c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#70470c"
    },
    "namespace": {
      "foreground": "#2e5650"
    },
    "number": {
      "foreground": "#3b3a3a"
    },
    "operator": {
      "foreground": "#923817"
    },
    "parameter": {
      "foreground": "#564634"
    },
    "property": {
      "foreground": "#2f5c56"
    },
    "property.declaration": {
      "foreground": "#564634"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#5e5517"
    },
    "string": {
      "foreground": "#1f5a3a"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2a601c"
    },
    "string.regexp": {
      "foreground": "#2a601c"
    },
    "struct": {
      "foreground": "#2e5650"
    },
    "type": {
      "foreground": "#2e5650"
    },
    "type.declaration": {
      "foreground": "#2e5650"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#2e5650"
    },
    "variable": {
      "foreground": "#564634"
    },
    "variable.defaultLibrary": {
      "foreground": "#545555"
    },
    "variable.readonly": {
      "foreground": "#3b3a3a"
    },
    "variable.readonly.local": {
      "foreground": "#564634"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#556776"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5e5517"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1f5a3a"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2a601c"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2a601c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#70470c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2e5650"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3b3a3a"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#564634"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#545555"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#2e5650"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#82450e"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#70470c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#692121"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#555127"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9e292d"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2f5c56"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#5e5517"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#8a8078"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3b3a3a"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#2e5650"
      }
    }
  ],
  "type": "light"
}