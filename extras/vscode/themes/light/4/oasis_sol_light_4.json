  "name": "Oasis Sol Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#333232"
    },
    "class": {
      "foreground": "#294e4a"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#6e5955"
    },
    "decorator": {
      "foreground": "#773e0d"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#6e5955"
    },
    "enum": {
      "foreground": "#294e4a"
    },
    "enumMember": {
      "foreground": "#333232"
    },
    "function": {
      "foreground": "#6e3b0c"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#6e3b0c"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#797979"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#294e4a"
    },
    "keyword": {
      "foreground": "#942023"
    },
    "label": {
      "foreground": "#942023"
    },
    "macro": {
      "foreground": "#1d5369"
    },
    "method": {
      "foreground": "#6e3b0c"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#6e3b0c"
    },
    "namespace": {
      "foreground": "#294e4a"
    },
    "number": {
      "foreground": "#333232"
    },
    "operator": {
      "foreground": "#853315"
    },
    "parameter": {
      "foreground": "#64332a"
    },
    "property": {
      "foreground": "#2c544e"
    },
    "property.declaration": {
      "foreground": "#64332a"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#942023"
    },
    "string": {
      "foreground": "#1f5137"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#27571b"
    },
    "string.regexp": {
      "foreground": "#27571b"
    },
    "struct": {
      "foreground": "#294e4a"
    },
    "type": {
      "foreground": "#294e4a"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#294e4a"
    },
    "variable": {
      "foreground": "#64332a"
    },
    "variable.defaultLibrary": {
      "foreground": "#4c4d4d"
    },
    "variable.readonly": {
      "foreground": "#333232"
    },
    "variable.readonly.local": {
      "foreground": "#64332a"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6e5955"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#942023"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#1f5137"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#27571b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#27571b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#6e3b0c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#294e4a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#333232"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#64332a"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#4c4d4d"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#294e4a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#773e0d"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6e3b0c"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#751414"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#911015"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#8a2e18"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#797979"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2c544e"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#942023"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#797979"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#333232"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#294e4a"
      }
    }
  ],
  "type": "light"
}