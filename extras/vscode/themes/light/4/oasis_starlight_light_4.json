  "name": "Oasis Starlight Light 4",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "boolean": {
      "fontStyle": "bold",
      "foreground": "#3e3c3c"
    },
    "class": {
      "foreground": "#355853"
    },
    "comment": {
      "fontStyle": "italic",
      "foreground": "#4e6a8d"
    },
    "decorator": {
      "foreground": "#87460f"
    },
    "documentation": {
      "fontStyle": "italic",
      "foreground": "#4e6a8d"
    },
    "enum": {
      "foreground": "#355853"
    },
    "enumMember": {
      "foreground": "#3e3c3c"
    },
    "function": {
      "foreground": "#7e430e"
    },
    "function.declaration": {
      "fontStyle": "bold",
      "foreground": "#7e430e"
    },
    "inlayHint": {
      "fontStyle": "italic",
      "foreground": "#918279"
    },
    "interface": {
      "fontStyle": "italic",
      "foreground": "#355853"
    },
    "keyword": {
      "foreground": "#125a97"
    },
    "label": {
      "foreground": "#125a97"
    },
    "macro": {
      "foreground": "#215e77"
    },
    "method": {
      "foreground": "#7e430e"
    },
    "method.declaration": {
      "fontStyle": "bold",
      "foreground": "#7e430e"
    },
    "namespace": {
      "foreground": "#355853"
    },
    "number": {
      "foreground": "#3e3c3c"
    },
    "operator": {
      "foreground": "#af1319"
    },
    "parameter": {
      "foreground": "#524b3b"
    },
    "property": {
      "foreground": "#315f59"
    },
    "property.declaration": {
      "foreground": "#524b3b"
    },
    "selfKeyword": {
      "fontStyle": "italic",
      "foreground": "#125a97"
    },
    "string": {
      "foreground": "#245c3f"
    },
    "string.escape": {
      "fontStyle": "bold",
      "foreground": "#2d631e"
    },
    "string.regexp": {
      "foreground": "#2d631e"
    },
    "struct": {
      "foreground": "#355853"
    },
    "type": {
      "foreground": "#355853"
    },
    "type.declaration": {
      "foreground": "#355853"
    },
    "typeParameter": {
      "fontStyle": "italic",
      "foreground": "#355853"
    },
    "variable": {
      "foreground": "#524b3b"
    },
    "variable.defaultLibrary": {
      "foreground": "#585856"
    },
    "variable.readonly": {
      "foreground": "#3e3c3c"
    },
    "variable.readonly.local": {
      "foreground": "#524b3b"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4e6a8d"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#125a97"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#245c3f"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2d631e"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2d631e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7e430e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#355853"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#3e3c3c"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#524b3b"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#585856"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#355853"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#87460f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7e430e"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#035087"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#11548e"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#af1319"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": [
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#918279"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#315f59"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#125a97"
      }
    },
    {
      "scope": [
        "text.html constant.character.entity",
        "text.html constant.character.entity punctuation",
        "constant.character.entity.xml",
        "constant.character.entity.xml punctuation",
        "constant.character.entity.js.jsx",
        "constant.charactger.entity.js.jsx punctuation",
        "constant.character.entity.tsx",
        "constant.character.entity.tsx punctuation"
      ],
      "settings": {
        "foreground": "#918279"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#3e3c3c"
      }
    },
    {
      "scope": [
        "support.class.component.jsx",
        "entity.name.tag.component.jsx"
      ],
      "settings": {
        "foreground": "#355853"
      }
    }
  ],
  "type": "light"
}